+export function llmModelLabel(info: unknown, deterministic = false): string {
+  if (deterministic) return "规则统计 · 未调用模型";
+  if (!info || typeof info !== "object" || !("model" in info) || typeof info.model !== "string" || !info.model) return "模型未知";
+  const provider = "provider" in info && typeof info.provider === "string" ? info.provider : "";
+  return provider ? `${provider} · ${info.model}` : info.model;
+}
diff --git a/lib/llm-preferences.ts b/lib/llm-preferences.ts
new file mode 100644
index 00000000..1f9659df
--- /dev/null
+++ b/lib/llm-preferences.ts
@@ -0,0 +1,344 @@
+import { constants } from "node:fs";
+import { open, mkdir, lstat, rename, rm } from "node:fs/promises";
+import path from "node:path";
+import { randomBytes } from "node:crypto";
+import { GROWDESK_CONFIG } from "@/lib/config";
+import {
+  getActiveLlmProfile,
+  getActiveLlmProfileId,
+  getLlmProfileById,
+  getLlmProfileProvider,
+  listLlmProfileEntries,
+  resolveLlmProfileModel,
+} from "@/lib/llm-profiles";
+import { getChatGPTPlan } from "@/lib/chatgpt-plan";
+import { growdeskFetch } from "@/lib/growdesk/client";
+import { requireData } from "@/lib/growdesk/bridge-protocol";
+
+export const LLM_FEATURES = [
+  "chat",
+  "daily_summary",
+  "tips",
+  "record_parse",
+  "nutrition_parse",
+  "search",
+  "growth_ocr",
+  "medical_ocr",
+  "voice",
+] as const;
+
+export type LlmFeature = (typeof LLM_FEATURES)[number];
+export type LlmPreferenceSource = "api" | "chatgpt";
+
+export interface LlmSelection {
+  feature: LlmFeature;
+  source: LlmPreferenceSource;
+  profileId: string;
+  modelId: string;
+}
+
+export interface LlmModelInfo {
+  source: LlmPreferenceSource;
+  provider: string;
+  model: string;
+  profileId?: string;
+}
+
+export interface LlmProfilePublic {
+  id: string;
+  name: string;
+  provider: string;
+  textModel: string;
+  visionModel: string;
+  available: boolean;
+}
+
+export class LlmPreferenceError extends Error {
+  readonly status: number;
+  readonly code: string;
+
+  constructor(status: number, code: string, message: string) {
+    super(message);
+    this.name = "LlmPreferenceError";
+    this.status = status;
+    this.code = code;
+  }
+}
+
+interface PreferenceFile {
+  version: 1;
+  users: Record<string, Partial<Record<LlmFeature, LlmSelection>>>;
+}
+
+const VISION_FEATURES = new Set<LlmFeature>(["nutrition_parse", "growth_ocr", "medical_ocr"]);
+const PROFILE_ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/;
+const MODEL_ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$/;
+const OWNER_PATTERN = /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/;
+const fileLocks = new Map<string, Promise<void>>();
+
+function isLlmFeature(value: unknown): value is LlmFeature {
+  return typeof value === "string" && (LLM_FEATURES as readonly string[]).includes(value);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function validateOwner(owner: string): void {
+  if (typeof owner !== "string" || !OWNER_PATTERN.test(owner)) {
+    throw new LlmPreferenceError(400, "invalid_owner", "Authenticated user identifier is invalid");
+  }
+}
+
+function parseSelection(value: unknown): LlmSelection {
+  if (!isRecord(value)) {
+    throw new LlmPreferenceError(502, "invalid_preferences_response", "AI preference data is invalid");
+  }
+  const keys = Object.keys(value).sort();
+  if (keys.join(",") !== "feature,modelId,profileId,source" ||
+      !isLlmFeature(value.feature) ||
+      (value.source !== "api" && value.source !== "chatgpt") ||
+      typeof value.profileId !== "string" || !PROFILE_ID_PATTERN.test(value.profileId) ||
+      typeof value.modelId !== "string" || !MODEL_ID_PATTERN.test(value.modelId)) {
+    throw new LlmPreferenceError(400, "invalid_selection", "Choose a valid AI profile and model");
+  }
+  return {
+    feature: value.feature,
+    source: value.source,
+    profileId: value.profileId,
+    modelId: value.modelId,
+  };
+}
+
+function preferenceFilePath(): string {
+  const configured = process.env.LLM_PREFERENCES_FILE?.trim();
+  return path.resolve(configured || path.join(process.cwd(), ".data", "llm-preferences.json"));
+}
+
+function storageError(message = "AI preferences could not be read or saved"): LlmPreferenceError {
+  return new LlmPreferenceError(500, "llm_preferences_storage_error", message);
+}
+
+/** File-backed preferences for legacy mode. The path is injectable for isolated tests. */
+export class FileLlmPreferenceStore {
+  readonly filePath: string;
+
+  constructor(filePath = preferenceFilePath()) {
+    this.filePath = path.resolve(filePath);
+  }
+
+  private async locked<T>(operation: () => Promise<T>): Promise<T> {
+    const key = this.filePath;
+    const previous = fileLocks.get(key) || Promise.resolve();
+    let release!: () => void;
+    const current = new Promise<void>((resolve) => { release = resolve; });
+    fileLocks.set(key, current);
+    await previous;
+    try {
+      return await operation();
+    } finally {
+      release();
+      if (fileLocks.get(key) === current) fileLocks.delete(key);
+    }
+  }
+
+  private async read(): Promise<PreferenceFile> {
+    let handle: Awaited<ReturnType<typeof open>> | undefined;
+    try {
+      handle = await open(this.filePath, constants.O_RDONLY | (constants.O_NOFOLLOW || 0));
+      const stat = await handle.stat();
+      if (!stat.isFile() || stat.nlink !== 1 || stat.size > 1_048_576) throw storageError();
+      const parsed: unknown = JSON.parse(await handle.readFile("utf8"));
+      if (!isRecord(parsed) || parsed.version !== 1 || !isRecord(parsed.users)) throw storageError();
+      const users: PreferenceFile["users"] = Object.create(null) as PreferenceFile["users"];
+      for (const [owner, rawFeatures] of Object.entries(parsed.users)) {
+        try { validateOwner(owner); } catch { throw storageError(); }
+        if (!isRecord(rawFeatures)) throw storageError();
+        const features: Partial<Record<LlmFeature, LlmSelection>> = Object.create(null) as Partial<Record<LlmFeature, LlmSelection>>;
+        for (const [feature, rawSelection] of Object.entries(rawFeatures)) {
+          if (!isLlmFeature(feature)) throw storageError();
+          let selection: LlmSelection;
+          try { selection = parseSelection(rawSelection); } catch { throw storageError(); }
+          if (selection.feature !== feature) throw storageError();
+          features[feature] = selection;
+        }
+        users[owner] = features;
+      }
+      return { version: 1, users };
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "ENOENT") return { version: 1, users: Object.create(null) as PreferenceFile["users"] };
+      if (error instanceof LlmPreferenceError) throw error;
+      throw storageError();
+    } finally {
+      await handle?.close().catch(() => undefined);
+    }
+  }
+
+  private async write(data: PreferenceFile): Promise<void> {
+    const directory = path.dirname(this.filePath);
+    let temporary = "";
+    let fileHandle: Awaited<ReturnType<typeof open>> | undefined;
+    let directoryHandle: Awaited<ReturnType<typeof open>> | undefined;
+    try {
+      await mkdir(directory, { recursive: true, mode: 0o700 });
+      const directoryStat = await lstat(directory);
+      if (!directoryStat.isDirectory() || directoryStat.isSymbolicLink()) throw storageError();
+      temporary = this.filePath + "." + randomBytes(12).toString("hex") + ".tmp";
+      fileHandle = await open(
+        temporary,
+        constants.O_CREAT | constants.O_EXCL | constants.O_WRONLY | (constants.O_NOFOLLOW || 0),
+        0o600,
+      );
+      await fileHandle.writeFile(JSON.stringify(data), { encoding: "utf8" });
+      await fileHandle.sync();
+      await fileHandle.close();
+      fileHandle = undefined;
+      await rename(temporary, this.filePath);
+      temporary = "";
+      directoryHandle = await open(directory, constants.O_RDONLY);
+      await directoryHandle.sync();
+    } catch (error) {
+      if (error instanceof LlmPreferenceError) throw error;
+      throw storageError();
+    } finally {
+      await fileHandle?.close().catch(() => undefined);
+      await directoryHandle?.close().catch(() => undefined);
+      if (temporary) await rm(temporary, { force: true }).catch(() => undefined);
+    }
+  }
+
+  async list(owner: string): Promise<LlmSelection[]> {
+    validateOwner(owner);
+    return this.locked(async () => Object.values((await this.read()).users[owner] || {}));
+  }
+
+  async get(owner: string, feature: LlmFeature): Promise<LlmSelection | undefined> {
+    validateOwner(owner);
+    if (!isLlmFeature(feature)) throw new LlmPreferenceError(400, "invalid_feature", "AI feature is invalid");
+    return this.locked(async () => (await this.read()).users[owner]?.[feature]);
+  }
+
+  async set(owner: string, selectionValue: unknown): Promise<LlmSelection> {
+    validateOwner(owner);
+    const selection = parseSelection(selectionValue);
+    return this.locked(async () => {
+      const data = await this.read();
+      const users = data.users as Record<string, Partial<Record<LlmFeature, LlmSelection>>>;
+      const preferences = users[owner] || (users[owner] = Object.create(null) as Partial<Record<LlmFeature, LlmSelection>>);
+      preferences[selection.feature] = selection;
+      await this.write(data);
+      return selection;
+    });
+  }
+}
+
+let cachedFileStore: FileLlmPreferenceStore | undefined;
+function localStore(): FileLlmPreferenceStore {
+  const filePath = preferenceFilePath();
+  if (!cachedFileStore || cachedFileStore.filePath !== filePath) cachedFileStore = new FileLlmPreferenceStore(filePath);
+  return cachedFileStore;
+}
+
+function usesSharedPreferences(accessToken?: string): boolean {
+  return Boolean(accessToken) || GROWDESK_CONFIG.enabled;
+}
+
+function requireSharedToken(accessToken?: string): string {
+  if (!accessToken) throw new LlmPreferenceError(401, "llm_preferences_auth_required", "Sign in to load AI preferences");
+  return accessToken;
+}
+
+function parseRemotePreferences(value: unknown): LlmSelection[] {
+  if (!isRecord(value) || !Array.isArray(value.preferences)) {
+    throw new LlmPreferenceError(502, "invalid_preferences_response", "GrowDesk returned invalid AI preferences");
+  }
+  return value.preferences.map(parseSelection);
+}
+
+export function getLlmProfileCatalog(): LlmProfilePublic[] {
+  return listLlmProfileEntries().map(({ id, profile }) => ({
+    id,
+    name: profile.name || id,
+    provider: getLlmProfileProvider(profile),
+    textModel: resolveLlmProfileModel(profile),
+    visionModel: resolveLlmProfileModel(profile, true),
+    available: Boolean(profile.apiKey && profile.baseUrl),
+  }));
+}
+
+export function getDefaultLlmModelInfo(vision = false): LlmModelInfo {
+  const profile = getActiveLlmProfile();
+  return {
+    source: "api",
+    provider: getLlmProfileProvider(profile),
+    model: resolveLlmProfileModel(profile, vision),
+    profileId: getActiveLlmProfileId(),
+  };
+}
+
+export async function getLlmPreferences(owner: string, accessToken?: string): Promise<LlmSelection[]> {
+  validateOwner(owner);
+  if (!usesSharedPreferences(accessToken)) return localStore().list(owner);
+  const token = requireSharedToken(accessToken);
+  const data = requireData(await growdeskFetch<{ preferences: unknown }>("/api/v1/web/ai/preferences", { accessToken: token }));
+  return parseRemotePreferences(data);
+}
+
+export async function getFeatureLlmSelection(
+  owner: string,
+  feature: LlmFeature,
+  accessToken?: string,
+): Promise<LlmSelection | undefined> {
+  if (!isLlmFeature(feature)) throw new LlmPreferenceError(400, "invalid_feature", "AI feature is invalid");
+  return (await getLlmPreferences(owner, accessToken)).find((selection) => selection.feature === feature);
+}
+
+export async function validateLlmSelection(owner: string, value: unknown): Promise<LlmSelection> {
+  validateOwner(owner);
+  const selection = parseSelection(value);
+  if (selection.source === "chatgpt") {
+    if (selection.feature !== "chat") {
+      throw new LlmPreferenceError(400, "chatgpt_chat_only", "ChatGPT plan can only be selected for chat");
+    }
+    try {
+      const models = await getChatGPTPlan().models(owner, selection.profileId);
+      if (!models.some((model) => model.id === selection.modelId)) {
+        throw new LlmPreferenceError(400, "chatgpt_model_unavailable", "The selected ChatGPT model is unavailable");
+      }
+    } catch (error) {
+      if (error instanceof LlmPreferenceError) throw error;
+      throw new LlmPreferenceError(400, "chatgpt_model_unavailable", "Connect the selected ChatGPT account and refresh its models");
+    }
+    return selection;
+  }
+
+  const profile = getLlmProfileById(selection.profileId);
+  if (!profile || !profile.baseUrl || !profile.apiKey) {
+    throw new LlmPreferenceError(400, "llm_profile_unavailable", "The selected API profile is unavailable");
+  }
+  const vision = VISION_FEATURES.has(selection.feature);
+  const expectedModel = resolveLlmProfileModel(profile, vision);
+  const allowedModels = selection.feature === "chat"
+    ? [resolveLlmProfileModel(profile), resolveLlmProfileModel(profile, true)]
+    : [expectedModel];
+  if (!allowedModels.includes(selection.modelId)) {
+    throw new LlmPreferenceError(400, "llm_model_unavailable", "The selected model is not available for this feature");
+  }
+  return selection;
+}
+
+export async function saveLlmPreference(
+  owner: string,
+  value: unknown,
+  accessToken?: string,
+): Promise<LlmSelection> {
+  const selection = await validateLlmSelection(owner, value);
+  if (!usesSharedPreferences(accessToken)) return localStore().set(owner, selection);
+  const token = requireSharedToken(accessToken);
+  const data = requireData(await growdeskFetch<LlmSelection>("/api/v1/web/ai/preferences", {
+    method: "PUT",
+    accessToken: token,
+    body: selection,
+  }));
+  return parseSelection(data);
+}
diff --git a/lib/llm-provenance.ts b/lib/llm-provenance.ts
new file mode 100644
index 00000000..88012087
--- /dev/null
+++ b/lib/llm-provenance.ts
@@ -0,0 +1,38 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import type { LlmModelInfo } from "@/lib/llm-preferences";
+import { getCurrentLlmModelInfo } from "@/lib/llm-context";
+
+const executions = new AsyncLocalStorage<{ llm: LlmModelInfo | null }>();
+export function withLlmProvenance<T>(work: () => T): T {
+  return executions.run({ llm: null }, work);
+}
+export function recordLlmModel(info: LlmModelInfo | null): void {
+  const execution = executions.getStore();
+  if (execution) execution.llm = info;
+}
+export function actualLlmModel(): LlmModelInfo | null {
+  return executions.getStore()?.llm ?? null;
+}
+
+/** Record the model sent, then prefer the provider's actual model identifier. */
+export async function llmFetch(input: string | URL, init: RequestInit): Promise<Response> {
+  let model = "";
+  try {
+    const body: unknown = typeof init.body === "string" ? JSON.parse(init.body) : null;
+    if (body && typeof body === "object" && "model" in body && typeof body.model === "string") model = body.model;
+  } catch { /* The upstream handler remains responsible for its request body. */ }
+  const selected = getCurrentLlmModelInfo();
+  const info: LlmModelInfo = {
+    ...selected, source: "api", provider: new URL(input).hostname, model: model || selected?.model || "unknown",
+  };
+  recordLlmModel(info);
+  const response = await fetch(input, init);
+  if (response.ok && response.headers.get("content-type")?.includes("application/json")) {
+    // Do not consume or replace the response that the feature parser receives.
+    const payload: unknown = await response.clone().json().catch(() => null);
+    if (payload && typeof payload === "object" && "model" in payload && typeof payload.model === "string" && payload.model.trim()) {
+      recordLlmModel({ ...info, model: payload.model });
+    }
+  }
+  return response;
+}
diff --git a/lib/llm-route.ts b/lib/llm-route.ts
new file mode 100644
index 00000000..53b862e8
--- /dev/null
+++ b/lib/llm-route.ts
@@ -0,0 +1,72 @@
+import { NextResponse } from "next/server";
+import { GROWDESK_CONFIG } from "@/lib/config";
+import { verifyBffCsrf } from "@/lib/growdesk/csrf";
+import { checkRateLimit } from "@/lib/rate-limit";
+import { requireAuth } from "@/lib/api-helpers";
+import { resolveBffSession } from "@/lib/growdesk/session";
+import { withLlmFeature, type LlmFeature } from "@/lib/llm-context";
+import { actualLlmModel, withLlmProvenance } from "@/lib/llm-provenance";
+
+/** Resolve trusted ownership before selecting a feature's stored configuration. */
+export function llmRoute(feature: LlmFeature, handler: (request: Request) => Promise<Response>) {
+  return async (request: Request): Promise<Response> => {
+    try {
+      let owner: string;
+      let accessToken: string | undefined;
+      if (GROWDESK_CONFIG.enabled) {
+        if (request.headers.get("sec-fetch-site") === "cross-site") return NextResponse.json({ error: "Forbidden" }, { status: 403 });
+        if (!["GET", "HEAD"].includes(request.method)) {
+          const denied = verifyBffCsrf(request, { enforceInTest: true });
+          if (denied) return denied;
+        }
+        const session = await resolveBffSession(request);
+        if (!session) return NextResponse.json({ error: "请先登录" }, { status: 401 });
+        owner = session.user.id; accessToken = session.accessToken;
+      } else {
+        const auth = await requireAuth(request);
+        if (auth.errorResponse) return auth.errorResponse;
+        owner = auth.user.id;
+      }
+      const rate = checkRateLimit(`llm-feature:${owner}:${feature}`, 30, 60_000);
+      if (!rate.success) return NextResponse.json({ error: "请求过于频繁，请稍后重试" }, { status: 429, headers: { "Retry-After": String(rate.resetSeconds) } });
+      const work = () => withLlmProvenance(async () => {
+        const response = await handler(request);
+        const info = actualLlmModel();
+        const headers = new Headers(response.headers);
+        headers.set("Cache-Control", "no-store");
+        // Header values are ASCII; JSON retains the original model spelling.
+        headers.set("X-LLM-Model", info ? encodeURIComponent(info.model) : "none");
+        if (info) headers.set("X-LLM-Provider", encodeURIComponent(info.provider));
+        if (!response.headers.get("content-type")?.includes("application/json")) {
+          return new Response(response.body, { status: response.status, headers });
+        }
+        const payload: unknown = await response.json();
+        if (payload && typeof payload === "object" && !Array.isArray(payload)) {
+          // Cached artifacts carry their original provenance, never today's selection.
+          const value = payload as Record<string, unknown>;
+          const summary = value.summary;
+          const cachedInfo = summary && typeof summary === "object" && "llm" in summary ? summary.llm : undefined;
+          const label = cachedInfo === undefined ? info : cachedInfo;
+          if (label && typeof label === "object" && "model" in label && typeof label.model === "string") {
+            headers.set("X-LLM-Model", encodeURIComponent(label.model));
+            if ("provider" in label && typeof label.provider === "string") headers.set("X-LLM-Provider", encodeURIComponent(label.provider));
+          }
+          return new Response(JSON.stringify({ ...value, llm: cachedInfo === undefined ? info : cachedInfo }), { status: response.status, headers });
+        }
+        return new Response(JSON.stringify(payload), { status: response.status, headers });
+      });
+      let started = false;
+      try {
+        return await withLlmFeature(owner, feature, accessToken, () => { started = true; return work(); });
+      } catch (error) {
+        // This GET only reads cached summaries or computes deterministic statistics.
+        // A removed AI profile must not prevent access to those ordinary records.
+        if (!started && feature === "daily_summary" && request.method === "GET") return work();
+        throw error;
+      }
+    } catch (error) {
+      console.error("[LLM feature] Configuration or execution unavailable", error instanceof Error ? error.name : "Error");
+      return NextResponse.json({ error: "此功能的模型配置不可用，请检查并重新保存配置" }, { status: 503, headers: { "Cache-Control": "no-store" } });
+    }
+  };
+}
diff --git a/tests/unit/agent-backend-credentials.test.ts b/tests/unit/agent-backend-credentials.test.ts
new file mode 100644
index 00000000..449adc89
--- /dev/null
+++ b/tests/unit/agent-backend-credentials.test.ts
@@ -0,0 +1,90 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  createAssistantMessageEventStream,
+  type AssistantMessage,
+  type AssistantMessageEventStream,
+  type Context,
+  type Model,
+  type SimpleStreamOptions,
+} from "@earendil-works/pi-ai";
+import type { StreamFn } from "@earendil-works/pi-agent-core";
+import { createBackendStreamFn } from "../../lib/agent/run";
+import { createRetryingModelStreamFn } from "../../lib/agent/stream-retry";
+
+const primaryModel: Model<"openai-completions"> = {
+  id: "test_primary_model",
+  name: "test_primary_model",
+  api: "openai-completions",
+  provider: "test_primary_provider",
+  baseUrl: "https://primary-provider.invalid/v1",
+  reasoning: false,
+  input: ["text"],
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+  contextWindow: 4096,
+  maxTokens: 256,
+  headers: { Authorization: "Bearer test_primary_header", "X-Source": "primary" },
+};
+const fallbackModel: Model<"openai-completions"> = {
+  ...primaryModel,
+  id: "test_fallback_model",
+  name: "test_fallback_model",
+  provider: "test_fallback_provider",
+  baseUrl: "https://fallback-provider.invalid/v1",
+  headers: { Authorization: "Bearer test_fallback_header", "X-Source": "fallback" },
+};
+
+function assistant(model: Model<any>, text: string, stopReason: "stop" | "error"): AssistantMessage {
+  return {
+    role: "assistant",
+    content: text ? [{ type: "text", text }] : [],
+    api: model.api,
+    provider: model.provider,
+    model: model.id,
+    usage: { input: 1, output: text.length, cacheRead: 0, cacheWrite: 0, totalTokens: 1 + text.length, cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 } },
+    stopReason,
+    ...(stopReason === "error" ? { errorMessage: "503 Service Unavailable" } : {}),
+    timestamp: 1,
+  };
+}
+
+function providerStream(model: Model<any>, shouldFail: boolean): AssistantMessageEventStream {
+  const stream = createAssistantMessageEventStream();
+  const message = assistant(model, shouldFail ? "test partial" : "test fallback success", shouldFail ? "error" : "stop");
+  if (shouldFail) stream.push({ type: "error", reason: "error", error: message });
+  else stream.push({ type: "done", reason: "stop", message });
+  return stream;
+}
+
+function fakeBackend(model: Model<any>, key: string, shouldFail: boolean, seen: Array<{ model: string; key?: string; headers?: Record<string, string> }>) {
+  const streamSimple = ((actualModel: Model<any>, _context: Context, options?: SimpleStreamOptions) => {
+    seen.push({ model: actualModel.id, key: options?.apiKey, headers: options?.headers as Record<string, string> });
+    return providerStream(actualModel, shouldFail);
+  }) as StreamFn;
+  return { model, getApiKey: () => key, models: { streamSimple } };
+}
+
+test("fallback candidate streams use their own API key and headers, never inherited credentials", async () => {
+  const seen: Array<{ model: string; key?: string; headers?: Record<string, string> }> = [];
+  const primary = createBackendStreamFn(fakeBackend(primaryModel, "test_primary_key", true, seen));
+  const fallback = createBackendStreamFn(fakeBackend(fallbackModel, "test_fallback_key", false, seen));
+  const retrying = createRetryingModelStreamFn(primary, {
+    maxRetries: 0,
+    fallbacks: [{ model: fallbackModel, invoke: fallback }],
+  });
+
+  const output = await retrying(primaryModel, { messages: [] } as Context, {
+    apiKey: "test_inherited_secret",
+    headers: { Authorization: "Bearer test_inherited_secret", "X-Inherited": "test_bad" },
+  });
+  const final = await output.result();
+
+  assert.equal(final.stopReason, "stop");
+  assert.deepEqual(seen.map((call) => [call.model, call.key]), [
+    ["test_primary_model", "test_primary_key"],
+    ["test_fallback_model", "test_fallback_key"],
+  ]);
+  assert.deepEqual(seen[0].headers, primaryModel.headers);
+  assert.deepEqual(seen[1].headers, fallbackModel.headers);
+  assert.equal(JSON.stringify(seen).includes("test_inherited_secret"), false);
+});
