+function findTurnAssistant(messages: any[], turnId: string): any | undefined {
+  return [...messages].reverse().find((message) =>
+    message.role === "assistant" && readChatTurnReceipt(toolsForMessage(message))?.turnId === turnId,
+  );
+}
