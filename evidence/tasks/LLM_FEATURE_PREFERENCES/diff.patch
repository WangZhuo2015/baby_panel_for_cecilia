+import { createHash } from "node:crypto";
+
+export type ChatTurnStatus = "running" | "completed" | "failed" | "cancelled";
+
+export interface ChatTurnReceipt {
+  type: "llm_turn";
+  turnId: string;
+  status: ChatTurnStatus;
+  attempt: number;
+  retryable: boolean;
+  writeToolStarted: boolean;
+  error?: string;
+}
+
+export interface ChatLlmModelInfo {
+  source: "api" | "chatgpt";
+  provider: string;
+  model: string;
+  profileId?: string;
+}
+
+export interface ChatLlmModelReceipt {
+  type: "llm_model";
+  llm: ChatLlmModelInfo;
+}
+
+export interface ChatRetryContext {
+  available: boolean;
+  contextDetail?: unknown;
+}
+
+export const CHAT_TURN_ID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+const WRITE_TOOLS = new Set(["save_medical_report", "record_vaccine", "delete_record"]);
+
+function deterministicMessageUuid(input: string): string {
+  const bytes = createHash("sha256").update(input).digest().subarray(0, 16);
+  bytes[6] = (bytes[6] & 0x0f) | 0x50;
+  bytes[8] = (bytes[8] & 0x3f) | 0x80;
+  const hex = bytes.toString("hex");
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
+}
+
+/** Stable owner/session/turn scoped UUID accepted by Web AI message APIs. */
+export function stableChatUserMessageId(ownerId: string, sessionId: string, turnId: string): string {
+  if (!CHAT_TURN_ID_PATTERN.test(turnId)) throw new Error("Invalid chat turn ID");
+  return deterministicMessageUuid(`baby-panel-chat-message\0${ownerId}\0${sessionId}\0user\0${turnId.toLowerCase()}`);
+}
+
+/** One assistant row per attempt keeps history immutable while the user message remains singular. */
+export function stableChatAssistantMessageId(ownerId: string, sessionId: string, turnId: string, attempt: number): string {
+  if (!CHAT_TURN_ID_PATTERN.test(turnId)) throw new Error("Invalid chat turn ID");
+  if (!Number.isInteger(attempt) || attempt < 1 || attempt > 100) throw new Error("Invalid chat attempt");
+  return deterministicMessageUuid(`baby-panel-chat-message\0${ownerId}\0${sessionId}\0assistant\0${turnId.toLowerCase()}\0${attempt}`);
+}
+
+/** Immutable claim ID for one retry attempt; first insertion owns that attempt. */
+export function stableChatRetryClaimMessageId(ownerId: string, sessionId: string, turnId: string, attempt: number): string {
+  if (!CHAT_TURN_ID_PATTERN.test(turnId)) throw new Error("Invalid chat turn ID");
+  if (!Number.isInteger(attempt) || attempt < 2 || attempt > 100) throw new Error("Invalid chat attempt");
+  return deterministicMessageUuid(`baby-panel-chat-message\0${ownerId}\0${sessionId}\0retry-claim\0${turnId.toLowerCase()}\0${attempt}`);
+}
+
+const MAX_RETRY_CONTEXT_BYTES = 128 * 1024;
+
+export function makeChatTurnRequestToolsJson(
+  turnId: string,
+  fingerprint?: string,
+  retryContext?: { contextDetailPresent: boolean; contextDetail?: unknown },
+): string {
+  if (!CHAT_TURN_ID_PATTERN.test(turnId)) throw new Error("Invalid chat turn ID");
+  const marker: Record<string, unknown> = {
+    type: "llm_turn_request",
+    role: "user",
+    turnId: turnId.toLowerCase(),
+    ...(fingerprint ? { fingerprint } : {}),
+  };
+  if (retryContext) {
+    marker.contextDetailPresent = retryContext.contextDetailPresent;
+    if (!retryContext.contextDetailPresent) {
+      marker.contextDetailStored = true;
+    } else {
+      const encoded = JSON.stringify(retryContext.contextDetail);
+      if (encoded !== undefined && Buffer.byteLength(encoded, "utf8") <= MAX_RETRY_CONTEXT_BYTES) {
+        marker.contextDetail = retryContext.contextDetail;
+        marker.contextDetailStored = true;
+      } else {
+        marker.contextDetailStored = false;
+      }
+    }
+  }
+  return JSON.stringify([marker]);
+}
+
+export function makeChatRetryClaimToolsJson(turnId: string, attempt: number): string {
+  if (!CHAT_TURN_ID_PATTERN.test(turnId) || !Number.isInteger(attempt) || attempt < 2) throw new Error("Invalid chat retry claim");
+  return JSON.stringify([{ type: "llm_retry_claim", role: "system", turnId: turnId.toLowerCase(), attempt }]);
+}
+
+export function readChatTurnRequest(tools: unknown): { turnId: string; fingerprint?: string } | undefined {
+  if (!Array.isArray(tools)) return undefined;
+  const entry = [...tools].reverse().find((item) => item && typeof item === "object" && (item as { type?: unknown }).type === "llm_turn_request") as { turnId?: unknown; fingerprint?: unknown } | undefined;
+  if (typeof entry?.turnId !== "string" || !CHAT_TURN_ID_PATTERN.test(entry.turnId)) return undefined;
+  return { turnId: entry.turnId.toLowerCase(), ...(typeof entry.fingerprint === "string" ? { fingerprint: entry.fingerprint } : {}) };
+}
+
+/** Restore only request context explicitly persisted on the owned user message. */
+export function readChatRetryContext(tools: unknown): ChatRetryContext | undefined {
+  if (!Array.isArray(tools)) return undefined;
+  const entry = [...tools].reverse().find((item) => item && typeof item === "object" && (item as { type?: unknown }).type === "llm_turn_request") as Record<string, unknown> | undefined;
+  if (typeof entry?.contextDetailPresent !== "boolean" || typeof entry.contextDetailStored !== "boolean") return undefined;
+  if (!entry.contextDetailStored) return { available: false };
+  return entry.contextDetailPresent
+    ? { available: true, contextDetail: entry.contextDetail }
+    : { available: true };
+}
+
+/** Unknown tools are treated conservatively: only explicit read-only names are safe to replay. */
+export function isPotentialWriteTool(name: string): boolean {
+  if (WRITE_TOOLS.has(name)) return true;
+  if (/^(get|query|search|list|find|fetch|lookup|recommend)_/i.test(name)) return false;
+  return true;
+}
+
+export function makeChatToolsJson(
+  toolTraces: unknown[],
+  options: { llm?: ChatLlmModelInfo; turn?: ChatTurnReceipt },
+): string | null {
+  const entries: unknown[] = [...toolTraces];
+  if (options.llm) entries.push({ type: "llm_model", llm: options.llm } satisfies ChatLlmModelReceipt);
+  if (options.turn) entries.push(options.turn);
+  return entries.length > 0 ? JSON.stringify(entries) : null;
+}
+
+export function readChatTurnReceipt(tools: unknown): ChatTurnReceipt | undefined {
+  if (!Array.isArray(tools)) return undefined;
+  for (let i = tools.length - 1; i >= 0; i -= 1) {
+    const item = tools[i] as Partial<ChatTurnReceipt> | null;
+    if (item?.type === "llm_turn" && typeof item.turnId === "string" && typeof item.status === "string") {
+      return item as ChatTurnReceipt;
+    }
+  }
+  return undefined;
+}
+
+export function readChatLlmModelInfo(tools: unknown): ChatLlmModelInfo | undefined {
+  if (!Array.isArray(tools)) return undefined;
+  for (let i = tools.length - 1; i >= 0; i -= 1) {
+    const item = tools[i] as Partial<ChatLlmModelReceipt> | null;
+    const llm = item?.type === "llm_model" ? item.llm : undefined;
+    if (
+      llm &&
+      (llm.source === "api" || llm.source === "chatgpt") &&
+      typeof llm.provider === "string" &&
+      typeof llm.model === "string"
+    ) {
+      return llm as ChatLlmModelInfo;
+    }
+  }
+  return undefined;
+}
+
+export function withoutChatMetadata<T>(tools: T[]): T[] {
+  return tools.filter((entry) => {
+    if (!entry || typeof entry !== "object") return true;
+    const type = (entry as { type?: unknown }).type;
+    return type !== "llm_model" && type !== "llm_turn" && type !== "llm_turn_request" && type !== "llm_retry_claim";
+  });
+}
diff --git a/lib/agent/stream-retry.ts b/lib/agent/stream-retry.ts
new file mode 100644
index 00000000..69be0fd6
--- /dev/null
+++ b/lib/agent/stream-retry.ts
@@ -0,0 +1,197 @@
+import {
+  createAssistantMessageEventStream,
+  type AssistantMessage,
+  type AssistantMessageEvent,
+  type Context,
+  type Model,
+  type SimpleStreamOptions,
+} from "@earendil-works/pi-ai";
+import type { StreamFn } from "@earendil-works/pi-agent-core";
+
+type ModelStreamCall = (
+  model: Model<any>,
+  context: Context,
+  options?: SimpleStreamOptions,
+) => ReturnType<StreamFn>;
+
+function errorText(error: unknown): string {
+  if (error instanceof Error) return error.message;
+  if (typeof error === "string") return error;
+  if (error && typeof error === "object" && "errorMessage" in error) {
+    return String((error as { errorMessage?: unknown }).errorMessage || "");
+  }
+  return String(error || "Unknown provider error");
+}
+
+function errorStatus(error: unknown): number | undefined {
+  if (!error || typeof error !== "object") return undefined;
+  const value = error as { status?: unknown; statusCode?: unknown; response?: { status?: unknown } };
+  const status = value.status ?? value.statusCode ?? value.response?.status;
+  return typeof status === "number" ? status : undefined;
+}
+
+export function getRetryAfterMs(error: unknown): number | null {
+  if (!error || typeof error !== "object") return null;
+  const value = error as { headers?: Headers | Record<string, unknown>; response?: { headers?: Headers | Record<string, unknown> } };
+  const headers = value.headers ?? value.response?.headers;
+  let raw: unknown;
+  if (headers && typeof (headers as Headers).get === "function") {
+    raw = (headers as Headers).get("retry-after");
+  } else if (headers && typeof headers === "object") {
+    const entries = headers as Record<string, unknown>;
+    raw = entries["retry-after"] ?? entries["Retry-After"];
+  }
+  if (typeof raw !== "string" && typeof raw !== "number") return null;
+  const text = String(raw).trim();
+  if (!text) return null;
+  const seconds = Number(text);
+  if (Number.isFinite(seconds) && seconds >= 0) return Math.round(seconds * 1000);
+  const date = Date.parse(text);
+  return Number.isFinite(date) ? Math.max(0, date - Date.now()) : null;
+}
+
+function wait(ms: number): Promise<void> {
+  return ms > 0 ? new Promise((resolve) => setTimeout(resolve, ms)) : Promise.resolve();
+}
+
+export function isRetryableModelStageError(error: unknown): boolean {
+  const status = errorStatus(error);
+  if (status === 429 || (status !== undefined && status >= 500 && status <= 599)) return true;
+  const message = errorText(error).toLowerCase();
+  return /(?:econnreset|econnrefused|etimedout|eai_again|und_err_connect_timeout|socket hang up|network error|fetch failed|temporar(?:y|ily) unavailable|gateway timeout|service unavailable|rate limit|too many requests|\b429\b)/i.test(message);
+}
+
+function failureMessage(model: Model<any>, error: unknown): AssistantMessage {
+  const text = errorText(error) || "模型请求未完成";
+  return {
+    role: "assistant",
+    content: [],
+    api: model.api,
+    provider: model.provider,
+    model: model.id,
+    usage: {
+      input: 0,
+      output: 0,
+      cacheRead: 0,
+      cacheWrite: 0,
+      totalTokens: 0,
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+    },
+    stopReason: "error",
+    errorMessage: text,
+    timestamp: Date.now(),
+  };
+}
+
+/**
+ * Retry a single model stage before exposing any of its events to Agent. This
+ * means partial text/tool-call deltas from a broken lazy stream are discarded;
+ * previously completed tool results stay in `context.messages` and are reused.
+ */
+export function createRetryingModelStreamFn(
+  invoke: ModelStreamCall,
+  options: {
+    maxRetries?: number;
+    fallbacks?: Array<{ model: Model<any>; invoke: ModelStreamCall }>;
+    onSuccess?: (message: AssistantMessage, model: Model<any>) => void;
+    wait?: (ms: number) => Promise<void>;
+  } = {},
+): StreamFn {
+  const maxRetries = Math.max(0, Math.min(2, options.maxRetries ?? 1));
+
+  return (model, context, callOptions) => {
+    const output = createAssistantMessageEventStream();
+    void (async () => {
+      let lastError: unknown = new Error("模型请求未完成");
+      let lastModel = model;
+
+      const candidates = [
+        { model, invoke },
+        ...(options.fallbacks || []),
+      ];
+      for (let candidateIndex = 0; candidateIndex < candidates.length; candidateIndex += 1) {
+        const candidate = candidates[candidateIndex];
+        lastModel = candidate.model;
+        for (let attempt = 0; attempt <= maxRetries; attempt += 1) {
+          let events: AssistantMessageEvent[] = [];
+          try {
+            const source = await candidate.invoke(candidate.model, context, callOptions);
+            let finalMessage: AssistantMessage | undefined;
+
+            for await (const event of source) {
+              events.push(event);
+              if (event.type === "done") finalMessage = event.message;
+              if (event.type === "error") finalMessage = event.error;
+            }
+
+            if (!finalMessage) {
+              finalMessage = await source.result().catch((error: unknown) => {
+                lastError = error;
+                return undefined;
+              });
+            }
+            if (!finalMessage) throw lastError;
+
+            if (finalMessage.stopReason === "error" || finalMessage.stopReason === "aborted") {
+              lastError = finalMessage.errorMessage || finalMessage;
+              if (
+                finalMessage.stopReason === "error" &&
+                attempt < maxRetries &&
+                isRetryableModelStageError(lastError)
+              ) {
+                const retryAfter = getRetryAfterMs(lastError);
+                if (retryAfter !== null && retryAfter > 30_000) {
+                  output.end(finalMessage);
+                  return;
+                }
+                await (options.wait || wait)(retryAfter ?? Math.min(250 * (2 ** attempt), 2_000));
+                continue;
+              }
+              if (
+                candidateIndex < candidates.length - 1 &&
+                finalMessage.stopReason === "error" &&
+                isRetryableModelStageError(lastError)
+              ) break;
+              for (const event of events) output.push(event);
+              output.end(finalMessage);
+              return;
+            }
+
+            for (const event of events) output.push(event);
+            output.end(finalMessage);
+            try {
+              options.onSuccess?.(finalMessage, candidate.model);
+            } catch {
+              // Attribution callbacks must not change whether a provider response succeeds.
+            }
+            return;
+          } catch (error) {
+            lastError = error;
+            if (attempt < maxRetries && isRetryableModelStageError(error)) {
+              const retryAfter = getRetryAfterMs(error);
+              if (retryAfter !== null && retryAfter <= 30_000) {
+                await (options.wait || wait)(retryAfter);
+                continue;
+              }
+              if (retryAfter === null) {
+                await (options.wait || wait)(Math.min(250 * (2 ** attempt), 2_000));
+                continue;
+              }
+            }
+            if (candidateIndex < candidates.length - 1 && isRetryableModelStageError(error)) break;
+            const failed = failureMessage(candidate.model, lastError);
+            output.push({ type: "error", reason: "error", error: failed });
+            output.end(failed);
+            return;
+          }
+        }
+      }
+
+      const failed = failureMessage(lastModel, lastError);
+      output.push({ type: "error", reason: "error", error: failed });
+      output.end(failed);
+    })();
+
+    return output;
+  };
+}
diff --git a/lib/llm-context.ts b/lib/llm-context.ts
new file mode 100644
index 00000000..cedd1b91
--- /dev/null
+++ b/lib/llm-context.ts
@@ -0,0 +1,112 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import { createHash } from "node:crypto";
+import {
+  type LlmFeature,
+  type LlmModelInfo,
+  type LlmSelection,
+  getFeatureLlmSelection,
+  validateLlmSelection,
+} from "./llm-preferences";
+import {
+  getActiveLlmProfile,
+  getActiveLlmProfileId,
+  getLlmProfileProvider,
+  resolveLlmProfileModel,
+  runWithLlmProfileScope,
+} from "./llm-profiles";
+
+export type { LlmFeature, LlmModelInfo, LlmSelection } from "./llm-preferences";
+
+export interface LlmFeatureScope {
+  owner: string;
+  feature: LlmFeature;
+  selection?: LlmSelection;
+}
+
+const featureScope = new AsyncLocalStorage<LlmFeatureScope>();
+
+/** Resolve persisted per-user configuration and apply it only to this async request chain. */
+export async function withLlmFeature<T>(
+  owner: string,
+  feature: LlmFeature,
+  accessToken: string | undefined,
+  work: () => T | Promise<T>,
+): Promise<T> {
+  const saved = await getFeatureLlmSelection(owner, feature, accessToken);
+  const selection = saved ? await validateLlmSelection(owner, saved) : undefined;
+  const execute = () => featureScope.run({ owner, feature, selection }, work);
+  if (selection?.source === "api") {
+    return runWithLlmProfileScope(selection.profileId, selection.modelId, execute);
+  }
+  // Clear an enclosing profile scope when a nested operation has no API choice.
+  return runWithLlmProfileScope(null, null, execute);
+}
+
+export function getCurrentLlmFeatureScope(): LlmFeatureScope | undefined {
+  return featureScope.getStore();
+}
+
+/** Safe provenance for the model configured for this feature; actual provider replies may refine it. */
+export function getCurrentLlmModelInfo(vision = false): LlmModelInfo | undefined {
+  const scope = featureScope.getStore();
+  if (!scope) return undefined;
+
+  if (scope.selection?.source === "chatgpt") {
+    return {
+      source: "chatgpt",
+      provider: "openai",
+      model: scope.selection.modelId,
+      profileId: scope.selection.profileId,
+    };
+  }
+
+  const profile = getActiveLlmProfile();
+  return {
+    source: "api",
+    provider: getLlmProfileProvider(profile),
+    model: scope.selection?.modelId || resolveLlmProfileModel(profile, vision),
+    profileId: scope.selection?.profileId || getActiveLlmProfileId(),
+  };
+}
+
+/** Stable opaque cache namespace. It includes owner, feature, and effective model selection. */
+export function getCurrentLlmCacheKey(): string | undefined {
+  const scope = featureScope.getStore();
+  if (!scope) return undefined;
+  const identity = scope.selection
+    ? {
+        source: scope.selection.source,
+        profileId: scope.selection.profileId,
+        modelId: scope.selection.modelId,
+      }
+    : {
+        source: "api",
+        profileId: getActiveLlmProfileId(),
+        textModel: resolveLlmProfileModel(getActiveLlmProfile()),
+        visionModel: resolveLlmProfileModel(getActiveLlmProfile(), true),
+      };
+  return createHash("sha256")
+    .update(JSON.stringify([scope.owner, scope.feature, identity]))
+    .digest("hex");
+}
+
+/** Non-secret identity for logs and model caches that need the resolved scope fields. */
+export function getCurrentLlmScopeIdentity(): {
+  owner: string;
+  feature: LlmFeature;
+  source: "api" | "chatgpt";
+  profileId: string;
+  modelId: string;
+} | undefined {
+  const scope = featureScope.getStore();
+  if (!scope) return undefined;
+  const info = getCurrentLlmModelInfo();
+  if (!info) return undefined;
+  return {
+    owner: scope.owner,
+    feature: scope.feature,
+    source: info.source,
+    profileId: info.profileId || "default",
+    modelId: info.model,
+  };
+}
