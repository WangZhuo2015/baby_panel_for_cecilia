diff --git a/app/api/ai/preferences/route.ts b/app/api/ai/preferences/route.ts
new file mode 100644
index 00000000..19b09404
--- /dev/null
+++ b/app/api/ai/preferences/route.ts
@@ -0,0 +1,112 @@
+import { NextResponse } from "next/server";
+import { requireAuth } from "@/lib/api-helpers";
+import { GROWDESK_CONFIG } from "@/lib/config";
+import {
+  getDefaultLlmModelInfo,
+  getLlmPreferences,
+  getLlmProfileCatalog,
+  LlmPreferenceError,
+  saveLlmPreference,
+} from "@/lib/llm-preferences";
+import { BridgeError, bridgeErrorResponse } from "@/lib/growdesk/bridge-protocol";
+import { verifyBffCsrf } from "@/lib/growdesk/csrf";
+import { resolveBffSession } from "@/lib/growdesk/session";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+type PrincipalResult =
+  | { userId: string; accessToken?: string }
+  | { errorResponse: Response };
+
+async function principal(request: Request, mutation: boolean): Promise<PrincipalResult> {
+  if (GROWDESK_CONFIG.enabled) {
+    if (mutation) {
+      const csrf = verifyBffCsrf(request);
+      if (csrf) return { errorResponse: csrf };
+    }
+    const session = await resolveBffSession(request);
+    if (!session) {
+      return { errorResponse: NextResponse.json({ error: "请先登录", code: "UNAUTHORIZED" }, { status: 401 }) };
+    }
+    return { userId: session.user.id, accessToken: session.accessToken };
+  }
+
+  const auth = await requireAuth(request);
+  if (auth.errorResponse) return { errorResponse: auth.errorResponse };
+  return { userId: auth.user.id };
+}
+
+function errorResponse(error: unknown): Response {
+  if (error instanceof LlmPreferenceError) {
+    return NextResponse.json(
+      { error: error.message, code: error.code },
+      { status: error.status, headers: { "Cache-Control": "no-store" } },
+    );
+  }
+  if (error instanceof BridgeError) return bridgeErrorResponse(error);
+  return NextResponse.json(
+    { error: "AI preferences could not be loaded or saved", code: "llm_preferences_unavailable" },
+    { status: 500, headers: { "Cache-Control": "no-store" } },
+  );
+}
+
+export async function GET(request: Request): Promise<Response> {
+  try {
+    const auth = await principal(request, false);
+    if ("errorResponse" in auth) return auth.errorResponse;
+    const preferences = await getLlmPreferences(auth.userId, auth.accessToken);
+    return NextResponse.json(
+      {
+        data: {
+          preferences,
+          profiles: getLlmProfileCatalog(),
+          activeProfileId: getDefaultLlmModelInfo().profileId,
+          defaultModelInfo: getDefaultLlmModelInfo(),
+        },
+      },
+      { headers: { "Cache-Control": "no-store" } },
+    );
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+export async function PUT(request: Request): Promise<Response> {
+  try {
+    const auth = await principal(request, true);
+    if ("errorResponse" in auth) return auth.errorResponse;
+
+    const contentType = request.headers.get("content-type")?.split(";")[0].trim().toLowerCase();
+    if (contentType !== "application/json") {
+      return NextResponse.json(
+        { error: "Request must use application/json", code: "invalid_content_type" },
+        { status: 415, headers: { "Cache-Control": "no-store" } },
+      );
+    }
+    const raw = await request.text();
+    if (raw.length > 2048) {
+      return NextResponse.json(
+        { error: "Request is too large", code: "request_too_large" },
+        { status: 413, headers: { "Cache-Control": "no-store" } },
+      );
+    }
+    let body: unknown;
+    try {
+      body = JSON.parse(raw);
+    } catch {
+      return NextResponse.json(
+        { error: "Request JSON is invalid", code: "invalid_json" },
+        { status: 400, headers: { "Cache-Control": "no-store" } },
+      );
+    }
+
+    const selection = await saveLlmPreference(auth.userId, body, auth.accessToken);
+    return NextResponse.json(
+      { data: selection },
+      { headers: { "Cache-Control": "no-store" } },
+    );
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
diff --git a/components/ui/ChatGPTPlanControls.tsx b/components/ui/ChatGPTPlanControls.tsx
new file mode 100644
index 00000000..187ab451
--- /dev/null
+++ b/components/ui/ChatGPTPlanControls.tsx
@@ -0,0 +1,322 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { LlmFeaturePreferences } from "@/components/ui/LlmFeaturePreferences";
+
+export interface ChatGPTSelection { profileId: string; modelId: string }
+export interface ChatControlReadiness { ready: boolean; message?: string }
+interface Profile { id: string; email: string; name: string; connected: boolean; sharing: boolean; reauthorize: boolean }
+interface Status { profiles: Profile[]; pending: { id: string; status: string; message?: string }[] }
+interface Attempt { id: string; profile_id: string; authorization_url: string; callback_port: number; expires_at: number }
+interface ApiProfile { id: string; name: string; provider: string; textModel: string; visionModel: string; available: boolean }
+interface ChatGPTModel { id: string; name: string; input?: string[] }
+interface SavedSelection { feature: "chat" | "daily_summary" | "tips" | "record_parse" | "nutrition_parse" | "search" | "growth_ocr" | "medical_ocr" | "voice"; source: "api" | "chatgpt"; profileId: string; modelId: string }
+interface PreferencesResponse {
+  data: {
+    preferences: SavedSelection[];
+    profiles: ApiProfile[];
+    activeProfileId: string;
+    defaultModelInfo: { source: "api"; provider: string; model: string; profileId?: string };
+  };
+}
+
+async function api<T>(path = "", body?: unknown, signal?: AbortSignal): Promise<T> {
+  const response = await fetch("/api/ai/chatgpt" + path, {
+    method: body === undefined ? "GET" : "POST", credentials: "same-origin", cache: "no-store",
+    headers: body === undefined ? { Accept: "application/json" } : { "Content-Type": "application/json" },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }), signal,
+  });
+  const value = await response.json();
+  if (!response.ok) throw new Error(value.message || value.error || "ChatGPT 连接暂不可用");
+  return value;
+}
+
+export function ChatGPTPlanControls({ disabled, onReadinessChange }: { disabled: boolean; onReadinessChange: (state: ChatControlReadiness) => void }) {
+  const [profiles, setProfiles] = useState<Profile[]>([]);
+  const [chatStatusLoaded, setChatStatusLoaded] = useState(false);
+  const [profileId, setProfileId] = useState("");
+  const [models, setModels] = useState<ChatGPTModel[]>([]);
+  const [modelId, setModelId] = useState("");
+  const [attempt, setAttempt] = useState<Attempt>();
+  const [message, setMessage] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [loadingModels, setLoadingModels] = useState(false);
+  const [catalogVersion, setCatalogVersion] = useState(0);
+  const [apiProfiles, setApiProfiles] = useState<ApiProfile[]>([]);
+  const [apiProfileId, setApiProfileId] = useState("");
+  const [defaultApiProfileId, setDefaultApiProfileId] = useState("");
+  const [defaultApiModel, setDefaultApiModel] = useState("");
+  const [selectedSource, setSelectedSource] = useState<"api" | "chatgpt">("api");
+  const [preferenceLoaded, setPreferenceLoaded] = useState(false);
+  const [preferenceSelection, setPreferenceSelection] = useState<SavedSelection>();
+  const [preferenceError, setPreferenceError] = useState("");
+  const [savingPreference, setSavingPreference] = useState(false);
+  const [preferenceMessage, setPreferenceMessage] = useState("");
+  const preferenceRequest = useRef(0);
+  const preferenceSaveLock = useRef(false);
+  const chatSelectionPending = useRef(false);
+  const changeRef = useRef(onReadinessChange); changeRef.current = onReadinessChange;
+  const lifecycle = useRef<AbortController | null>(null);
+
+  useEffect(() => {
+    const controller = new AbortController(); lifecycle.current = controller;
+    void api<Status>("", undefined, controller.signal).then(data => setProfiles(data.profiles)).catch(error => { if (!controller.signal.aborted) setMessage(error.message); }).finally(() => { if (!controller.signal.aborted) setChatStatusLoaded(true); });
+    void fetch("/api/ai/preferences", { credentials: "same-origin", cache: "no-store", signal: controller.signal })
+      .then(async response => {
+        const value = await response.json();
+        if (!response.ok) throw new Error(value.error || "模型配置加载失败");
+        return value as PreferencesResponse;
+      })
+      .then(value => {
+        if (controller.signal.aborted) return;
+        const prefs = value.data;
+        setApiProfiles(prefs.profiles || []);
+        const saved = prefs.preferences?.find(item => item.feature === "chat");
+        const defaultProfileId = prefs.activeProfileId || prefs.defaultModelInfo?.profileId || "";
+        setDefaultApiProfileId(defaultProfileId);
+        setDefaultApiModel(prefs.defaultModelInfo?.model || "");
+        setPreferenceSelection(saved);
+        if (saved?.source === "chatgpt") {
+          setSelectedSource("chatgpt"); setProfileId(saved.profileId); setModelId(saved.modelId);
+        } else {
+          setSelectedSource("api"); setApiProfileId(saved?.profileId || defaultProfileId);
+          setModelId(saved?.modelId || prefs.defaultModelInfo?.model || "");
+        }
+        setPreferenceLoaded(true);
+      })
+      .catch(error => {
+        if (!controller.signal.aborted) {
+          setPreferenceError(error instanceof Error ? error.message : "模型配置加载失败");
+          setMessage(error instanceof Error ? error.message : "模型配置加载失败");
+          setPreferenceLoaded(true);
+        }
+      });
+    return () => { controller.abort(); };
+  }, []);
+
+  useEffect(() => {
+    const controller = new AbortController();
+    setModels([]);
+    if (selectedSource !== "chatgpt" || !profileId) { setLoadingModels(false); return () => controller.abort(); }
+    setLoadingModels(true);
+    void api<{ models: ChatGPTModel[] }>("?profile_id=" + encodeURIComponent(profileId), undefined, controller.signal)
+      .then(data => {
+        if (!controller.signal.aborted) {
+          setModels(data.models);
+          const nextModelId = data.models.some(model => model.id === modelId) ? modelId : (data.models[0]?.id || "");
+          setModelId(nextModelId);
+          setMessage("使用 ChatGPT 套餐额度，与其他应用共享用量上限。");
+          if (chatSelectionPending.current && nextModelId) {
+            chatSelectionPending.current = false;
+            void persistSelection({ feature: "chat", source: "chatgpt", profileId, modelId: nextModelId });
+          }
+        }
+      })
+      .catch(error => { if (!controller.signal.aborted) setMessage(error.message); })
+      .finally(() => { if (!controller.signal.aborted) setLoadingModels(false); });
+    return () => controller.abort();
+  }, [selectedSource, profileId, catalogVersion]);
+
+  async function persistSelection(next: SavedSelection) {
+    if (preferenceSaveLock.current) return;
+    preferenceSaveLock.current = true;
+    const requestId = ++preferenceRequest.current;
+    setSavingPreference(true);
+    setPreferenceError("");
+    setPreferenceMessage("正在保存模型配置…");
+    try {
+      const response = await fetch("/api/ai/preferences", {
+        method: "PUT", credentials: "same-origin", cache: "no-store",
+        headers: { "Content-Type": "application/json" }, body: JSON.stringify(next),
+        signal: lifecycle.current?.signal,
+      });
+      const value = await response.json();
+      if (!response.ok) throw new Error(value.error || "模型配置保存失败");
+      if (requestId === preferenceRequest.current) {
+        setPreferenceSelection(value.data as SavedSelection);
+        setPreferenceMessage("模型配置已保存。");
+      }
+    } catch (error) {
+      if (requestId === preferenceRequest.current && !lifecycle.current?.signal.aborted) {
+        const message = error instanceof Error ? error.message : "模型配置保存失败";
+        setPreferenceError(message);
+        setPreferenceMessage(`保存失败：${message}`);
+      }
+    } finally {
+      preferenceSaveLock.current = false;
+      if (requestId === preferenceRequest.current && !lifecycle.current?.signal.aborted) setSavingPreference(false);
+    }
+  }
+
+  useEffect(() => {
+    if (!preferenceLoaded) {
+      changeRef.current({ ready: false, message: "正在加载模型配置…" });
+      return;
+    }
+    if (preferenceError) {
+      changeRef.current({ ready: false, message: `模型配置不可用：${preferenceError}` });
+      return;
+    }
+    if (savingPreference) {
+      changeRef.current({ ready: false, message: "正在保存模型配置…" });
+      return;
+    }
+    if (selectedSource === "api") {
+      const profile = apiProfiles.find(item => item.id === apiProfileId);
+      const availableModels = profile ? [...new Set([profile.textModel, profile.visionModel].filter(Boolean))] : [];
+      const isUntouchedDefault = !preferenceSelection && apiProfileId === defaultApiProfileId && modelId === defaultApiModel;
+      const matchesSaved = preferenceSelection?.source === "api" && preferenceSelection.profileId === apiProfileId && preferenceSelection.modelId === modelId;
+      if (!profile?.available || !availableModels.includes(modelId) || !(isUntouchedDefault || matchesSaved)) {
+        changeRef.current({ ready: false, message: profile ? "请保存一个可用的 API profile 和模型" : "没有可用的 API profile" });
+        return;
+      }
+      changeRef.current({ ready: true });
+      return;
+    }
+    const chatProfile = profiles.find(item => item.id === profileId);
+    const matchesSaved = preferenceSelection?.source === "chatgpt" && preferenceSelection.profileId === profileId && preferenceSelection.modelId === modelId;
+    if (!chatStatusLoaded || loadingModels || !chatProfile?.connected || !chatProfile.sharing || !models.some(item => item.id === modelId) || !matchesSaved) {
+      changeRef.current({ ready: false, message: "请连接 ChatGPT 并保存可用模型" });
+      return;
+    }
+    changeRef.current({ ready: true });
+  }, [preferenceLoaded, preferenceError, savingPreference, selectedSource, apiProfiles, apiProfileId, modelId, preferenceSelection, defaultApiProfileId, defaultApiModel, profiles, profileId, chatStatusLoaded, loadingModels, models]);
+
+  useEffect(() => {
+    if (!attempt) return;
+    const controller = new AbortController();
+    let timer: ReturnType<typeof setTimeout>;
+    const poll = async () => {
+      if (controller.signal.aborted) return;
+      if (Date.now() >= attempt.expires_at) { setMessage("授权已超时，请重新连接。"); setAttempt(undefined); return; }
+      try {
+        const data = await api<Status>("", undefined, controller.signal);
+        setProfiles(data.profiles);
+        const current = data.pending.find(p => p.id === attempt.id);
+        if (current?.status === "connected") { setProfileId(attempt.profile_id); setCatalogVersion(version => version + 1); setMessage(data.profiles.find(profile => profile.id === attempt.profile_id)?.sharing ? "ChatGPT 已连接，后续请求将使用你的套餐额度。" : "ChatGPT 账号已连接，但尚未允许套餐使用，请重新授权。"); setAttempt(undefined); return; }
+        if (current?.status === "error") { setMessage(current.message || "授权未完成，请重试。"); setAttempt(undefined); return; }
+      } catch (error) { if (!controller.signal.aborted) setMessage(error instanceof Error ? error.message : "连接暂不可用"); }
+      if (!controller.signal.aborted) timer = setTimeout(() => { void poll(); }, 2500);
+    };
+    timer = setTimeout(() => { void poll(); }, 1500);
+    return () => { controller.abort(); clearTimeout(timer); };
+  }, [attempt]);
+
+  async function connect(existing = false) {
+    setBusy(true);
+    try {
+      const next = await api<Attempt>("", { action: "connect", ...(existing ? { profile_id: profileId } : {}) }, lifecycle.current?.signal);
+      if (new URL(next.authorization_url).origin !== "https://auth.openai.com") throw new Error("授权地址无效");
+      setAttempt(next); setMessage("等待 ChatGPT 授权完成。");
+    } catch (error) { if (!lifecycle.current?.signal.aborted) setMessage(error instanceof Error ? error.message : "授权未完成"); }
+    finally { if (!lifecycle.current?.signal.aborted) setBusy(false); }
+  }
+  async function disconnect() {
+    setBusy(true);
+    try {
+      const result = await api<{ revoked: boolean }>("", { action: "disconnect", profile_id: profileId }, lifecycle.current?.signal);
+      setModels([]); setModelId("");
+      setMessage(result.revoked ? "已断开 ChatGPT 连接。可重新授权或选择现有 API 配置。" : "本应用已断开；远端撤销尚未确认，请在 ChatGPT 设置中断开此应用。");
+      const data = await api<Status>("", undefined, lifecycle.current?.signal); setProfiles(data.profiles);
+    } catch (error) { if (!lifecycle.current?.signal.aborted) setMessage(error instanceof Error ? error.message : "断开连接未完成"); }
+    finally { if (!lifecycle.current?.signal.aborted) setBusy(false); }
+  }
+
+  function chooseSource(nextSource: "api" | "chatgpt") {
+    setSelectedSource(nextSource);
+    setPreferenceError("");
+    if (nextSource === "api") {
+      const profile = apiProfiles.find(item => item.id === apiProfileId) || apiProfiles.find(item => item.id === defaultApiProfileId);
+      if (!profile) return;
+      const next = { feature: "chat" as const, source: "api" as const, profileId: profile.id, modelId: profile.visionModel || profile.textModel };
+      setApiProfileId(profile.id); setModelId(next.modelId);
+      void persistSelection(next);
+      return;
+    }
+    chatSelectionPending.current = true;
+    if (!profileId) {
+      const connected = profiles.find(item => item.connected && item.sharing) || profiles[0];
+      if (connected) setProfileId(connected.id);
+    }
+    setModelId("");
+  }
+
+  function chooseApiProfile(nextProfileId: string) {
+    const profile = apiProfiles.find(item => item.id === nextProfileId);
+    setApiProfileId(nextProfileId);
+    setSelectedSource("api");
+    setPreferenceError("");
+    if (!profile) { setModelId(""); return; }
+    const nextModelId = profile.visionModel || profile.textModel;
+    setModelId(nextModelId);
+    void persistSelection({ feature: "chat", source: "api", profileId: profile.id, modelId: nextModelId });
+  }
+
+  function chooseModel(nextModelId: string) {
+    setModelId(nextModelId);
+    setPreferenceError("");
+    if (selectedSource === "api" && apiProfileId) {
+      void persistSelection({ feature: "chat", source: "api", profileId: apiProfileId, modelId: nextModelId });
+    } else if (selectedSource === "chatgpt" && profileId) {
+      void persistSelection({ feature: "chat", source: "chatgpt", profileId, modelId: nextModelId });
+    }
+  }
+
+  return <div className="flex flex-col gap-2">
+  <details className="rounded-xl border border-primary/15 p-2 text-xs" aria-label="ChatGPT 订阅与模型">
+    <summary className="cursor-pointer font-medium">{selectedSource === "chatgpt" ? "聊天使用 ChatGPT 套餐" : "聊天模型来源与 ChatGPT 订阅"}</summary>
+    <div className="mt-2 flex flex-col gap-2">
+      <label className="flex items-center gap-2">模型来源
+        <select aria-label="聊天模型来源" className="min-w-0 flex-1 rounded border p-1 bg-card" disabled={disabled || busy || savingPreference || !preferenceLoaded} value={selectedSource} onChange={event => chooseSource(event.target.value as "api" | "chatgpt")}>
+          <option value="api">API profile</option>
+          <option value="chatgpt">ChatGPT 套餐</option>
+        </select>
+      </label>
+      {selectedSource === "api" ? <>
+        <label className="flex items-center gap-2">API profile
+          <select aria-label="API profile" className="min-w-0 flex-1 rounded border p-1 bg-card" disabled={disabled || busy || savingPreference || !preferenceLoaded} value={apiProfileId} onChange={event => chooseApiProfile(event.target.value)}>
+            <option value="">请选择 profile</option>
+            {apiProfiles.map(profile => <option key={profile.id} value={profile.id} disabled={!profile.available}>{profile.name} · {profile.provider}{profile.available ? "" : "（不可用）"}</option>)}
+          </select>
+        </label>
+        <label className="flex items-center gap-2">模型
+          <select aria-label="API 模型" className="min-w-0 flex-1 rounded border p-1 bg-card" disabled={disabled || busy || savingPreference || !apiProfiles.some(item => item.id === apiProfileId)} value={modelId} onChange={event => chooseModel(event.target.value)}>
+            {apiProfiles.filter(item => item.id === apiProfileId).flatMap(profile => {
+              return [...new Set([profile.textModel, profile.visionModel].filter(Boolean))]
+                .map(id => <option key={id} value={id}>{id} · {id === profile.visionModel ? "文本与图片" : "文本"}</option>);
+            })}
+          </select>
+        </label>
+        {apiProfiles.some(item => item.id === apiProfileId && item.textModel !== item.visionModel && modelId === item.textModel) &&
+          <p role="status" className="text-amber-700">当前是文本模型；图片提问前请切换到该 profile 的视觉模型。</p>}
+      </> : <>
+        <label className="flex items-center gap-2">ChatGPT 账号
+          <select aria-label="ChatGPT 账号" className="min-w-0 flex-1 rounded border p-1 bg-card" disabled={disabled || busy || savingPreference} value={profileId} onChange={event => { chatSelectionPending.current = true; setProfileId(event.target.value); setModelId(""); }}>
+            <option value="">请选择账号</option>
+            {profiles.map(profile => <option key={profile.id} value={profile.id}>{profile.email || profile.name}{profile.connected && profile.sharing ? "" : "（需授权）"}</option>)}
+          </select>
+        </label>
+        <label className="flex items-center gap-2">模型
+        <select aria-label="ChatGPT 模型" className="min-w-0 flex-1 rounded border p-1 bg-card" disabled={disabled || savingPreference || loadingModels || !models.length} value={modelId} onChange={event => chooseModel(event.target.value)}>
+          {!models.length && <option value="">{loadingModels ? "读取可用模型…" : "请连接账号或刷新授权"}</option>}
+          {models.map(model => <option key={model.id} value={model.id}>{model.name}{model.input?.includes("image") ? " · 支持图片" : " · 仅文本"}</option>)}
+        </select>
+        </label>
+      </>}
+      <div className="flex flex-wrap items-center gap-2">
+        <button type="button" className="rounded border px-2 py-1" disabled={disabled || busy || savingPreference} onClick={() => { void connect(); }}>Continue with ChatGPT</button>
+        {profileId && <><button type="button" disabled={disabled || busy || savingPreference} onClick={() => { void connect(true); }}>重新授权</button><button type="button" disabled={disabled || busy || savingPreference} onClick={() => { void disconnect(); }}>断开连接</button></>}
+        <a className="underline" href="https://chatgpt.com/#settings/Usage" target="_blank" rel="noopener noreferrer">管理 ChatGPT 用量</a>
+      </div>
+      {attempt && <div>
+        <p>远程访问时，先在自己的电脑上通过 SSH 转发授权端口 <code>{attempt.callback_port}</code>，再打开授权。具体方法见项目的 ChatGPT 接入文档。</p>
+        <a className="underline" href={attempt.authorization_url} target="_blank" rel="noopener noreferrer" referrerPolicy="no-referrer">打开 ChatGPT 授权</a>
+      </div>}
+      {preferenceMessage && <p role="status">{preferenceMessage}</p>}
+      {message && <p role="status">{message}</p>}
+      {selectedSource === "chatgpt" && profileId && <p>相关宝宝资料会发送至 OpenAI，使用你授权的 ChatGPT 套餐额度。</p>}
+    </div>
+  </details>
+  <LlmFeaturePreferences disabled={disabled || savingPreference || !preferenceLoaded} />
+  </div>;
+}
diff --git a/components/ui/LlmFeaturePreferences.tsx b/components/ui/LlmFeaturePreferences.tsx
new file mode 100644
index 00000000..67d00aa0
--- /dev/null
+++ b/components/ui/LlmFeaturePreferences.tsx
@@ -0,0 +1,144 @@
+"use client";
+
+import { useEffect, useMemo, useRef, useState } from "react";
+
+type Feature = "daily_summary" | "tips" | "record_parse" | "nutrition_parse" | "growth_ocr" | "medical_ocr" | "voice";
+type Selection = { feature: Feature; source: "api"; profileId: string; modelId: string };
+type Profile = { id: string; name: string; provider: string; textModel: string; visionModel: string; available: boolean };
+type PreferencesResponse = { data: { preferences: Selection[]; profiles: Profile[]; activeProfileId: string; defaultModelInfo?: { model: string; profileId?: string } } };
+
+const FEATURE_ROWS: { id: Feature; label: string; vision: boolean }[] = [
+  { id: "daily_summary", label: "每日日报", vision: false },
+  { id: "tips", label: "育儿建议", vision: false },
+  { id: "record_parse", label: "记录解析", vision: false },
+  { id: "nutrition_parse", label: "营养识别", vision: true },
+  { id: "growth_ocr", label: "生长记录 OCR", vision: true },
+  { id: "medical_ocr", label: "医疗单据 OCR", vision: true },
+  { id: "voice", label: "语音记录整理", vision: false },
+];
+
+function modelFor(profile: Profile | undefined, vision: boolean): string {
+  return vision ? profile?.visionModel || "" : profile?.textModel || "";
+}
+
+export function LlmFeaturePreferences({ disabled = false }: { disabled?: boolean }) {
+  const [profiles, setProfiles] = useState<Profile[]>([]);
+  const [saved, setSaved] = useState<Partial<Record<Feature, Selection>>>({});
+  const [drafts, setDrafts] = useState<Partial<Record<Feature, Selection>>>({});
+  const [loading, setLoading] = useState(true);
+  const [loadError, setLoadError] = useState("");
+  const [saving, setSaving] = useState<Partial<Record<Feature, boolean>>>({});
+  const [messages, setMessages] = useState<Partial<Record<Feature, string>>>({});
+  const [errors, setErrors] = useState<Partial<Record<Feature, string>>>({});
+  const controllerRef = useRef<AbortController | null>(null);
+  const saveLocks = useRef(new Set<Feature>());
+
+  useEffect(() => {
+    const controller = new AbortController();
+    controllerRef.current = controller;
+    void fetch("/api/ai/preferences", { credentials: "same-origin", cache: "no-store", signal: controller.signal })
+      .then(async (response) => {
+        const value = await response.json();
+        if (!response.ok) throw new Error(value.error || "模型配置加载失败");
+        return value as PreferencesResponse;
+      })
+      .then((value) => {
+        if (controller.signal.aborted) return;
+        const data = value.data;
+        const available = Array.isArray(data.profiles) ? data.profiles : [];
+        const persisted = Object.fromEntries((data.preferences || []).map((item) => [item.feature, item])) as Partial<Record<Feature, Selection>>;
+        const defaultProfileId = data.activeProfileId || data.defaultModelInfo?.profileId || "";
+        const initial: Partial<Record<Feature, Selection>> = { ...persisted };
+        for (const row of FEATURE_ROWS) {
+          if (initial[row.id]) continue;
+          const profile = available.find((item) => item.id === defaultProfileId);
+          const modelId = modelFor(profile, row.vision);
+          if (profile && modelId) initial[row.id] = { feature: row.id, source: "api", profileId: profile.id, modelId };
+        }
+        setProfiles(available);
+        setSaved(persisted);
+        setDrafts(initial);
+      })
+      .catch((error) => {
+        if (!controller.signal.aborted) setLoadError(error instanceof Error ? error.message : "模型配置加载失败");
+      })
+      .finally(() => { if (!controller.signal.aborted) setLoading(false); });
+    return () => controller.abort();
+  }, []);
+
+  const availableProfiles = useMemo(() => profiles.filter((profile) => profile.available), [profiles]);
+
+  function changeProfile(feature: Feature, profileId: string, vision: boolean) {
+    const profile = profiles.find((item) => item.id === profileId);
+    const modelId = modelFor(profile, vision);
+    setDrafts((current) => ({ ...current, [feature]: profile && modelId ? { feature, source: "api", profileId, modelId } : undefined }));
+    setErrors((current) => ({ ...current, [feature]: "" }));
+    setMessages((current) => ({ ...current, [feature]: "未保存" }));
+  }
+
+  async function save(feature: Feature) {
+    if (saveLocks.current.has(feature)) return;
+    const selection = drafts[feature];
+    if (!selection) return;
+    saveLocks.current.add(feature);
+    setSaving((current) => ({ ...current, [feature]: true }));
+    setErrors((current) => ({ ...current, [feature]: "" }));
+    setMessages((current) => ({ ...current, [feature]: "正在保存…" }));
+    try {
+      const response = await fetch("/api/ai/preferences", {
+        method: "PUT", credentials: "same-origin", cache: "no-store",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(selection), signal: controllerRef.current?.signal,
+      });
+      const value = await response.json();
+      if (!response.ok) throw new Error(value.error || "保存失败，请重试");
+      const savedSelection = value.data as Selection;
+      setSaved((current) => ({ ...current, [feature]: savedSelection }));
+      setDrafts((current) => ({ ...current, [feature]: savedSelection }));
+      setMessages((current) => ({ ...current, [feature]: "已保存" }));
+    } catch (error) {
+      const message = error instanceof Error ? error.message : "保存失败，请重试";
+      setErrors((current) => ({ ...current, [feature]: message }));
+      setMessages((current) => ({ ...current, [feature]: "保存失败" }));
+    } finally {
+      saveLocks.current.delete(feature);
+      setSaving((current) => ({ ...current, [feature]: false }));
+    }
+  }
+
+  return <details className="rounded-xl border border-primary/15 p-2 text-xs" aria-label="其他功能的模型配置">
+    <summary className="cursor-pointer font-medium">其他功能的模型配置</summary>
+    <div className="mt-2 flex flex-col gap-2">
+      {loading ? <p role="status">正在读取模型配置…</p> : loadError ? <p role="alert" className="text-red-700">模型配置加载失败：{loadError}</p> : <>
+        {FEATURE_ROWS.map((row) => {
+          const draft = drafts[row.id];
+          const profile = profiles.find((item) => item.id === draft?.profileId);
+          const isSaved = Boolean(saved[row.id] && saved[row.id]?.profileId === draft?.profileId && saved[row.id]?.modelId === draft?.modelId);
+          return <section key={row.id} className="rounded-lg border border-primary/10 p-2">
+            <div className="flex flex-wrap items-center justify-between gap-2">
+              <strong>{row.label}{row.vision ? " · 视觉模型" : " · 文本模型"}</strong>
+              <span className="text-text-muted">{messages[row.id] || (isSaved ? "已保存" : "使用默认配置，尚未单独保存")}</span>
+            </div>
+            <div className="mt-2 flex flex-wrap items-center gap-2">
+              <label className="flex min-w-[12rem] flex-1 items-center gap-1">API profile
+                <select aria-label={`${row.label} API profile`} className="min-w-0 flex-1 rounded border p-1 bg-card" disabled={disabled || saving[row.id] || availableProfiles.length === 0} value={draft?.profileId || ""} onChange={(event) => changeProfile(row.id, event.target.value, row.vision)}>
+                  <option value="">请选择 profile</option>
+                  {profiles.map((item) => <option key={item.id} value={item.id} disabled={!item.available}>{item.name} · {item.provider}{item.available ? "" : "（不可用）"}</option>)}
+                </select>
+              </label>
+              <label className="flex min-w-[12rem] flex-1 items-center gap-1">模型
+                <select aria-label={`${row.label} 模型`} className="min-w-0 flex-1 rounded border p-1 bg-card" disabled={disabled || saving[row.id] || !profile?.available} value={draft?.modelId || ""} onChange={(event) => setDrafts((current) => ({ ...current, [row.id]: { feature: row.id, source: "api", profileId: profile!.id, modelId: event.target.value } }))}>
+                  {draft?.modelId && <option value={draft.modelId}>{draft.modelId}</option>}
+                  {!draft?.modelId && <option value="">该 profile 没有可用模型</option>}
+                </select>
+              </label>
+              <button type="button" className="rounded border px-2 py-1" disabled={disabled || saving[row.id] || !draft || isSaved} onClick={() => { void save(row.id); }}>{saving[row.id] ? "保存中…" : "保存"}</button>
+            </div>
+            {errors[row.id] && <p role="alert" className="mt-1 text-red-700">{errors[row.id]}</p>}
+          </section>;
+        })}
+        <p className="rounded-lg bg-primary/5 p-2 text-text-muted">搜索当前不调用 LLM；不提供搜索模型选择。</p>
+      </>}
+    </div>
+  </details>;
+}
