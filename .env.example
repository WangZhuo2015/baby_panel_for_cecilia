# ==============================================================================
# 宝宝成长工作台 (Baby Panel) — 生产 / 公网部署环境变量示例
# ==============================================================================

# 1. 数据库配置 (SQLite 文件路径，容器部署建议挂载到持久化卷，如 file:/app/data/app.db)
DATABASE_URL="file:./dev.db"

# 2. JWT 登录 Session 密钥 (公网部署务必修改为强随机字符串，如 openssl rand -base64 32)
JWT_SECRET="baby-panel-jwt-secret-key-change-me-in-production-2026"

# 3. AI 育儿大模型配置 (支持 DeepSeek / OpenAI / 通义千问 / 本地 Ollama 或 Hermes 等 OpenAI 兼容协议)
AI_BASE_URL="https://api.deepseek.com/v1"
AI_API_KEY=""
AI_MODEL="deepseek-chat"
# 视觉多模态模型 (用于生长体检单 OCR 拍照识别，如 gpt-4o-mini / qwen-vl-max / hermes-vision)
AI_VISION_MODEL="gpt-4o-mini"

# 4. Web Push 推送通知 (VAPID 密钥，使用 npx tsx scripts/generate-vapid-keys.ts 生成)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# 5. 推送通知群发鉴权 Token (防止未授权调用 /api/push/send 群发推送)
PUSH_SEND_TOKEN=""

# 6. 服务端口 (默认 3000)
PORT=3000
NODE_ENV=production
