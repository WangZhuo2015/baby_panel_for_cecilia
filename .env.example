# 数据库连接(SQLite 文件路径,相对项目根目录)
DATABASE_URL="file:./dev.db"

# Web Push (VAPID) — 用 `npm run` 或 `npx tsx scripts/generate-vapid-keys.ts` 生成
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 群发推送鉴权 token(未配置则 /api/push/send 返回 503,禁止群发)
PUSH_SEND_TOKEN=

# 可选:本地 AI 服务(Hermes/OpenAI 兼容接口),默认 http://localhost:8642
# HERMES_API_URL=http://localhost:8642
