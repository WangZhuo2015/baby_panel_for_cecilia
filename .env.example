# ==============================================================================
# 宝宝成长工作台 (Baby Panel) — 生产 / 公网部署环境变量示例
# ==============================================================================

# 1. 数据库配置 (SQLite 文件路径，容器部署建议挂载到持久化卷，如 file:/app/data/app.db)
DATABASE_URL="file:./dev.db"

# 2. JWT 登录 Session 密钥 (公网部署务必修改为强随机字符串，如 openssl rand -base64 32)
JWT_SECRET="baby-panel-jwt-secret-key-change-me-in-production-2026"

# 3. AI 大模型配置 (标准 OpenAI Chat Completions 协议)
# 支持厂商示例：
# - OpenAI 官方: AI_BASE_URL="https://api.openai.com/v1", AI_MODEL="gpt-4o-mini", AI_VISION_MODEL="gpt-4o-mini"
# - DeepSeek: AI_BASE_URL="https://api.deepseek.com/v1", AI_MODEL="deepseek-chat"
# - 通义千问 (DashScope): AI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1", AI_MODEL="qwen-turbo", AI_VISION_MODEL="qwen-vl-max"
# - 硅基流动 / OpenRouter / One-API / 本地 Ollama 均支持标准 OpenAI 协议
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY="sk-..."
AI_MODEL="gpt-4o-mini"
# 视觉多模态大模型 (用于血常规、体检单、微量元素单据智能 OCR 与指标结构化提取)
AI_VISION_MODEL="gpt-4o-mini"

# 4. Web Push 推送通知 (VAPID 密钥，使用 npx tsx scripts/generate-vapid-keys.ts 生成)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# 5. 推送通知群发鉴权 Token (防止未授权调用 /api/push/send 群发推送)
PUSH_SEND_TOKEN=""

# 6. 服务端口 (默认 3000)
PORT=3000
NODE_ENV=production
