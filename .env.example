# ==============================================================================
# 宝宝成长工作台 (Baby Panel) — 生产 / 公网部署环境变量示例
# ==============================================================================

# 1. 数据库配置 (SQLite 文件路径，容器部署建议挂载到持久化卷，如 file:/app/data/app.db)
DATABASE_URL="file:./dev.db"

# 2. JWT 登录 Session 密钥 (公网部署务必修改为强随机字符串，如 openssl rand -base64 32)
JWT_SECRET="baby-panel-jwt-secret-key-change-me-in-production-2026"

# 3. AI 大模型配置
# Web 聊天 / 识图 / 每日建议走 OpenRouter + Pi Agent（不使用 Hermes）
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="stealth/ox-alpha"
# 联网搜索 API（可选：Tavily / Serper / Brave，未配置时自动走开箱即用必应与百科引擎）
TAVILY_API_KEY=""
# SERPER_API_KEY=""
# BRAVE_API_KEY=""
# 可选：未配置 OPENROUTER_API_KEY 时，OCR/建议可回落到其它 OpenAI 兼容接口
# （不要指向 Hermes gateway :8642 或 hermes-agent）
# AI_BASE_URL="https://api.deepseek.com/v1"
# AI_API_KEY="sk-..."
# AI_MODEL="deepseek-chat"
# AI_VISION_MODEL="gpt-4o-mini"
# MCP 默认必须带会话凭证（防串号）。仅单用户 CLI 调试才设为 1
# MCP_ALLOW_STATIC_USER="0"

# 4. Web Push 推送通知 (VAPID 密钥，使用 npx tsx scripts/generate-vapid-keys.ts 生成)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# 5. 推送通知群发鉴权 Token (防止未授权调用 /api/push/send 群发推送)
PUSH_SEND_TOKEN=""

# 6. 服务端口 (默认 3000)
PORT=3000
NODE_ENV=production

# 7. 反向代理信任开关 (限流器客户端 IP 解析)
# true(默认): 应用部署在 nginx/Caddy 等可信反代之后，信任 x-real-ip / x-forwarded-for
#   ⚠️ 前提：代理必须覆写这些头（nginx 默认行为），且不要把应用端口直接暴露公网
# false: 应用直接暴露公网，转发头不可信，所有限流按单一桶处理（保守不可绕过）
TRUST_PROXY="true"

# 8. 演示账号种子开关 (seed 在空库时是否创建 admin/123456 演示账号)
# 生产环境务必保持未设置！仅在本地开发或演示环境设为 1
SEED_DEMO=""

# 9. 语音转文字（自托管中文 ASR，可选）
# 命令模板：{input} 为临时音频路径；命令需将识别文本打印到 stdout
# 部署指南见 docs/ASR_SETUP.md（推荐 SenseVoice / faster-whisper）
ASR_COMMAND=""
