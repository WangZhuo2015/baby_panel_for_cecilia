# ==============================================================================
# 宝宝成长工作台 (Baby Panel) — 专门的测试环境变量 (Test Environment)
# 🚨 严禁指向真实生产库 (prod.db / dev.db)，强制使用独立的 dev_test.db
# ==============================================================================

# 1. 独立测试数据库（绝对禁止使用 prod.db / dev.db）
DATABASE_URL="file:./dev_test.db"

# 2. 运行环境与独立端口（避免与正在运行的 3088 生产服务冲突）
NODE_ENV="test"
PORT=3089
BABY_PANEL_URL="http://127.0.0.1:3089"

# 3. 测试专用 JWT 密钥（符合 32 字符最小安全长度要求，仅用于测试）
JWT_SECRET="test_jwt_secret_must_be_32_chars_min_length_ok"

# 4. 语音快速路径 MVP 密钥
VOICE_MVP_SECRET="voice_mvp_sec_test2026"

# 5. 推送通知测试 Mock 配置
VAPID_PUBLIC_KEY="BNDOGEg1Q8IokXnuo_QGRVGRycNTtyRYD-dbTtUIZ4GbhPhHJ1V2JZo7wmovBweV6cHLwOG1K1gHVxSq1K1AX7g"
VAPID_PRIVATE_KEY="0vpc9NrravLMAKx0aoOPDNb5nJai2WUcDIzY4DUACHY"
VAPID_SUBJECT="mailto:test@baby-panel-test.local"
PUSH_SEND_TOKEN="test_push_send_token_for_ci_suite"

# 6. AI 接口测试配置（安全 Mock 配置，避免跑测试时产生外部 API 调用费用）
AI_BASE_URL="http://127.0.0.1:3089/api/mock-ai"
AI_API_KEY=""
AI_MODEL="mock-model"
AI_VISION_MODEL="mock-model"
OPENROUTER_API_KEY="test_dummy_or_key"
OPENROUTER_MODEL="z-ai/glm-5.2:free"
TAVILY_API_KEY="test_tavily_dummy_key"
