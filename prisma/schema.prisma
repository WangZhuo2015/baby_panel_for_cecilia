generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── User & Family Models (Multi-parent Sharing) ────────────────────────────

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  passwordHash      String
  displayName       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       FamilyMember[]
  pushSubscriptions PushSubscription[]
  aiChatSessions    AiChatSession[]
  oauthCodes        OAuthAuthorizationCode[]
  oauthTokens       OAuthRefreshToken[]
  oauthConsents     OAuthConsent[]
}

model Family {
  id           String             @id @default(uuid())
  name         String
  inviteCode   String             @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      FamilyMember[]
  babies       Baby[]
  foodStatuses       FamilyFoodStatus[]
  bookStatuses       FamilyBookStatus[]
  formulaProducts    FormulaProduct[]
  supplementProducts SupplementProduct[]
}

model FamilyMember {
  id        String   @id @default(uuid())
  familyId  String
  userId    String
  role      String   @default("member") // "admin" | "member"
  relation  String   @default("parent") // "mother" | "father" | "grandparent" | "caregiver" | "other"
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@index([familyId])
}

// ─── Core Baby Tracking Models ──────────────────────────────────────────────

model Baby {
  id                  String               @id @default(uuid())
  familyId            String
  family              Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  nickname            String
  gender              String               @default("female")
  birthDate           String
  gestationalAge      Int?
  avatarUrl           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  feedingRecords      FeedingRecord[]
  sleepRecords        SleepRecord[]
  diaperRecords       DiaperRecord[]
  growthMeasurements  GrowthMeasurement[]
  foodLogRecords      FoodLogRecord[]
  foodPlans           FoodPlan[]
  vaccineRecords      VaccineRecord[]
  vaccineSelections   VaccineSelection[]
  medicalReports      MedicalReport[]
  aiChatSessions      AiChatSession[]
  supplementSchedules SupplementSchedule[]
  supplementRecords   SupplementRecord[]
  oauthCodes          OAuthAuthorizationCode[]
  oauthTokens         OAuthRefreshToken[]
  oauthConsents       OAuthConsent[]
  recordSnapshots     RecordSnapshot[]

  @@index([familyId])
}


model FeedingRecord {
  id               String          @id @default(uuid())
  babyId           String
  baby             Baby            @relation(fields: [babyId], references: [id], onDelete: Cascade)
  formulaProductId String?
  formulaProduct   FormulaProduct? @relation(fields: [formulaProductId], references: [id], onDelete: SetNull)
  clientId         String? // 离线提交幂等键（outbox 重放防重）
  recordedById     String?
  timestamp        String
  type             String   // breast, formula, mixed
  amountMl         Int?
  leftMinutes      Int?
  rightMinutes     Int?
  spitUp           Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())

  @@index([babyId, timestamp])
  @@index([formulaProductId])
  @@unique([babyId, clientId])
}

// ─── Formula & Supplement Products & Nutrition Models ───────────────────────

model FormulaProduct {
  id                  String          @id @default(uuid())
  familyId            String
  family              Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name                String
  brand               String
  stage               Int?
  scoopWeightG        Float           @default(4.3)
  waterPerScoopMl     Float           @default(30.0)
  reconstitutionRatio Float           @default(0.135)
  servingSizeUnit     String          @default("per_100g") // "per_100g" | "per_100ml" | "per_100kJ"
  nutrientsJson       String          // JSON map: Record<string, { amount: number, unit: string }>
  notes               String?
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  feedingRecords      FeedingRecord[]

  @@index([familyId])
}

model SupplementProduct {
  id            String               @id @default(uuid())
  familyId      String
  family        Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name          String
  brand         String
  dosageForm    String               // "drops" | "capsule" | "liquid_ml" | "sachet" | "tablet"
  unitName      String               // "滴" | "粒" | "ml" | "袋" | "片"
  defaultDose   Float                @default(1.0)
  nutrientsJson String               // JSON map: Record<string, { amount: number, unit: string }>
  notes         String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  schedules     SupplementSchedule[]
  records       SupplementRecord[]

  @@index([familyId])
}

model SupplementSchedule {
  id             String            @id @default(uuid())
  babyId         String
  baby           Baby              @relation(fields: [babyId], references: [id], onDelete: Cascade)
  productId      String
  product        SupplementProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  frequency      String            @default("daily") // "daily" | "alternate_day" | "specific_days"
  customDaysJson String?           // JSON array e.g. [1, 3, 5] (Mon, Wed, Fri) or anchor date
  targetDose     Float             @default(1.0)
  reminderTime   String?           // "09:00"
  isActive       Boolean           @default(true)
  startDate      String?           // "YYYY-MM-DD"
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([babyId])
  @@index([productId])
}

model SupplementRecord {
  id           String            @id @default(uuid())
  babyId       String
  baby         Baby              @relation(fields: [babyId], references: [id], onDelete: Cascade)
  productId    String
  product      SupplementProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  clientId     String?           // 离线提交幂等键
  recordedById String?
  date         String            // YYYY-MM-DD
  time         String            // HH:mm
  dose         Float             @default(1.0)
  unitName     String?
  notes        String?
  createdAt    DateTime          @default(now())

  @@index([babyId, date])
  @@index([productId])
  @@unique([babyId, clientId])
}

model SleepRecord {
  id               String   @id @default(uuid())
  babyId           String
  baby             Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  clientId       String? // 离线提交幂等键（outbox 重放防重）
  recordedById     String?
  startTime        String
  endTime          String
  type             String   // night, day
  nightWakingCount Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())

  @@index([babyId, startTime])
  @@index([babyId, endTime])
  @@unique([babyId, clientId])
}

model DiaperRecord {
  id              String   @id @default(uuid())
  babyId          String
  baby            Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  clientId       String? // 离线提交幂等键（outbox 重放防重）
  recordedById    String?
  timestamp       String
  type            String   // pee, poop, both
  poopColor       String?  // yellow, green, brown, other
  poopConsistency String?  // loose, paste, formed
  notes           String?
  createdAt       DateTime @default(now())

  @@index([babyId, timestamp])
  @@unique([babyId, clientId])
}

model GrowthMeasurement {
  id                  String   @id @default(uuid())
  babyId              String
  baby                Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  clientId            String? // 离线幂等
  recordedById        String?
  date                String
  ageInMonths         Int?
  ageLabel            String
  weightKg            Float?
  heightCm            Float?
  headCircumferenceCm Float?
  percentile          Int?
  imageUrl            String?
  createdAt           DateTime @default(now())

  @@index([babyId, date])
  @@unique([babyId, clientId])
}

model MedicalReport {
  id           String   @id @default(uuid())
  babyId       String
  baby         Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  recordedById String?
  title        String
  category     String   // "blood" | "growth" | "trace_element" | "allergy" | "general"
  date         String   // YYYY-MM-DD
  hospital     String?
  doctorNotes  String?
  aiSummary    String?
  itemsJson    String   // JSON string of MedicalReportItem[]
  imageUrl     String?  // Archived photo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([babyId, date])
  @@index([babyId, category, date])
}


model FoodLogRecord {
  id            String   @id @default(uuid())
  babyId        String
  baby          Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  clientId       String? // 离线提交幂等键（outbox 重放防重）
  recordedById  String?
  date          String
  time          String
  foods         String   // JSON array
  portion       String   // little, half, most, all
  acceptance    Int
  babyState     String   // happy, neutral, rejected
  hasAbnormal   Boolean  @default(false)
  abnormalNotes String?
  createdAt     DateTime @default(now())

  @@index([babyId, date])
  @@unique([babyId, clientId])
}

// ─── Family Status for Shared Knowledge (Foods & Books) ─────────────────────

model FamilyFoodStatus {
  id             String   @id @default(uuid())
  familyId       String
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  foodId         String
  status         String   @default("to_try") // "tried" | "to_try"
  firstAddedDate String?
  acceptance     Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([familyId, foodId])
}

model FamilyBookStatus {
  id         String   @id @default(uuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  bookId     String
  readCount  Int      @default(0)
  isFavorite Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([familyId, bookId])
}

// ─── Data Version / Source Reference ─────────────────────────────────────────

model DataRelease {
  id        String      @id @default(uuid())
  title     String
  asOf      String      // e.g. "2026-08-03"
  createdAt DateTime    @default(now())
  sources   SourceRef[]
}

model SourceRef {
  id                  String               @id @default(uuid())
  sourceId            String               // e.g. "src_nip_2026"
  title               String
  organization        String
  year                Int?
  publicationDate     String?
  url                 String?
  sourceLevel         String?              // A, B, C, D
  sourceType          String?
  accessedDate        String?
  notes               String?
  dataReleaseId       String?
  dataRelease         DataRelease?         @relation(fields: [dataReleaseId], references: [id])
  vaccineSourceRefs   VaccineSourceRef[]   @relation("vaccineSourceRefs")
  milestoneSourceRefs MilestoneSourceRef[] @relation("milestoneSourceRefs")

  @@index([dataReleaseId])
}

// ─── Vaccine Models (Shared Static Reference) ───────────────────────────────

model Vaccine {
  id                        String              @id @default(uuid())
  vaccineId                 String              @unique // e.g. "vac_hepb"
  name                      String
  shortName                 String
  englishName               String?
  programType               String              // national_immunization_program, non_program, provincial_immunization_program
  legacyLabel               String?             // "一类（旧称）" etc.
  sexRestriction            String              @default("all")
  chinaNational             Boolean             @default(false)
  diseases                  String              // JSON array
  targetPopulation          String?
  policyEffectiveDate       String?
  policyVersion             String?
  routineHealthyChildOption Boolean             @default(true)
  manualReviewRequired      Boolean             @default(false)
  marketStatus              String?             // marketed, etc.
  productBrandName          String?
  productManufacturer       String?
  productApprovalNumber     String?
  jiangsuNotes              String?
  suzhouNotes               String?
  catchUpSupported          Boolean             @default(false)
  catchUpRules              String              // JSON array of strings
  simultaneousVaccination   String?
  substitutionRules         String              // JSON array of strings
  contraindications         String              // JSON array of strings
  precautions               String              // JSON array of strings
  specialPopulations        String              // JSON array of strings
  regionalOverrides         String              // JSON array of regional override objects
  regimenOptions            String              // JSON array
  sourceRefsJson            String              // JSON array of source IDs
  createdAt                 DateTime            @default(now())
  doses                     VaccineDose[]
  sourceRefs                VaccineSourceRef[]
}

model VaccineDose {
  id                              String   @id @default(uuid())
  vaccineId                       String
  vaccine                         Vaccine  @relation(fields: [vaccineId], references: [id])
  doseNumber                      Int
  doseLabel                       String
  recommendedAgeMonths            Int?
  minimumAgeDays                  Int?
  maximumAgeDays                  Int?
  recommendedAgeMaxMonths         Int?
  minimumIntervalDaysFromPrevious Int?
  maximumIntervalDaysFromPrevious Int?
  route                           String?
  site                            String?
  doseVolumeMl                    Float?
  notes                           String?
  sourceRefsJson                  String   // JSON array

  @@index([vaccineId])
}


model VaccineSourceRef {
  id          String    @id @default(uuid())
  vaccineId   String
  vaccine     Vaccine   @relation(fields: [vaccineId], references: [id])
  sourceRefId String
  sourceRef   SourceRef @relation("vaccineSourceRefs", fields: [sourceRefId], references: [id])
}

model VaccineStrategyGroup {
  id             String  @id @default(uuid())
  strategyId     String  @unique
  name           String
  scope          String?
  baseProgram    String?
  optionsJson    String  // JSON array of option objects
  sourceRefsJson String  // JSON array
}

model VaccineScheduleEntry {
  id             String  @id @default(uuid())
  ageMonths      Int?
  ageDays        Int?
  ageLabel       String?
  vaccineId      String
  doseNumber     Int
  priority       String  // routine, optional
  isOptional     Boolean @default(false)
  action         String?
  selectionGroup String?
  notes          String?
  sourceRefsJson String  // JSON array
}

model ScheduleEngineRule {
  id             String @id @default(uuid())
  ruleId         String @unique
  type           String
  vaccineIdsJson String // JSON array
  description    String
  sourceRefsJson String // JSON array
}

// ─── Development Milestone Models (Shared Static Reference) ─────────────────

model DevelopmentMilestone {
  id                             String               @id @default(uuid())
  milestoneId                    String               @unique // e.g. "mil_so_2m_looks_face"
  category                       String               // social_emotional, language, cognitive, gross_motor, fine_motor
  originalDomain                 String?              // 社交/情绪, 语言/沟通, etc.
  title                          String
  description                    String
  assessmentAgeMonths            Int
  ageRangeEarliestMonth          Int?
  ageRangeMedianMonth            Int?
  ageRangeLatestMonth            Int?
  criterionType                  String?              // by_age
  criterionThreshold             String?
  criterionDescription           String?
  observationMethod              String?
  requiresProfessionalAssessment Boolean              @default(false)
  sourceSystem                   String?
  sourceRefsJson                 String               // JSON array
  sourceRefs                     MilestoneSourceRef[]

  @@index([assessmentAgeMonths, category])
}


model MilestoneSourceRef {
  id          String               @id @default(uuid())
  milestoneId String
  milestone   DevelopmentMilestone @relation(fields: [milestoneId], references: [id])
  sourceRefId String
  sourceRef   SourceRef            @relation("milestoneSourceRefs", fields: [sourceRefId], references: [id])
}

model DevelopmentWarningSign {
  id                String @id @default(uuid())
  warningSignId     String @unique // e.g. "rf_3m_01"
  ageMonths         Int
  category          String // language, social_emotional, cognitive, gross_motor, fine_motor
  description       String
  recommendedAction String
  urgency           String // routine_evaluation, etc.
  sourceRefsJson    String // JSON array
}

// ─── Feeding Guideline Models (Shared Static Reference) ─────────────────────

model FeedingGuideline {
  id                    String   @id @default(uuid())
  ageMinMonths          Int
  ageMaxMonths          Int
  mealFrequency         String?
  milkGuidance          String?
  textureJson           String   // JSON array of strings
  foodDiversityJson     String   // JSON array of strings
  responsiveFeedingJson String   // JSON array of strings
  safetyJson            String   // JSON array of strings
  sourceRefsJson        String   // JSON array
}

// ─── Food Item Model (Shared Static Reference) ──────────────────────────────

model FoodItem {
  id                               String   @id @default(uuid())
  foodId                           String   @unique // e.g. "food_iron_cereal"
  name                             String
  icon                             String
  category                         String   // grain, protein, vegetable, fruit, dairy, other
  foodGroup                        String?  // grain, meat, egg, fish, etc.
  // Introduction data
  recommendedFromMonth             Int?
  recommendedToMonth               Int?
  exactMonthEvidence               Boolean  @default(false)
  guidance                         String?  // main display text
  // Allergen data
  isCommonAllergen                 Boolean? // null = unconfirmed
  allergenIntroductionGuidance     String?
  highRiskInfantNeedsMedicalAdvice Boolean?
  // Choking
  chokingRisk                      Boolean  @default(false)
  chokingNotes                     String?
  // Preparation
  preparationJson                  String   // JSON array of strings
  // Avoid before
  avoidBeforeMonths                Int?
  // Nutrition
  nutritionJson                    String   // JSON array of strings
  // Texture by age
  textureByAgeJson                 String   // JSON array
  // Notes
  notes                            String?
  sourceRefsJson                   String   // JSON array
}

// ─── Book Model (Shared Static Reference) ───────────────────────────────────

model Book {
  id                         String   @id @default(uuid())
  bookId                     String   @unique // e.g. "book_beng"
  title                      String
  originalTitle              String?
  authorJson                 String   // JSON array
  illustratorJson            String?  // JSON array
  translatorJson             String?  // JSON array
  publisher                  String?
  isbn                       String?
  editionYear                Int?
  language                   String?
  origin                     String?  // translated, domestic
  ageMinMonths               Int?
  ageMaxMonths               Int?
  categoriesJson             String   // JSON array
  bookFormat                 String?  // picture_book, board_book, etc.
  description                String?
  interactionSuggestionsJson String?  // JSON array
  whyAgeAppropriate          String?
  ratingScore                Float?   // null means no data
  ratingCount                Int?
  ratingSource               String?
  ratingRetrievedDate        String?
  coverColor                 String?  // null means use default
  sourceRefsJson             String   // JSON array
}

// ─── Activity Model (Shared Static Reference) ───────────────────────────────

model ActivityRecommendation {
  id                   String  @id @default(uuid())
  activityId           String  @unique // e.g. "act_face_talk"
  title                String
  categoriesJson       String  // JSON array
  ageMinMonths         Int?
  ageMaxMonths         Int?
  developmentGoalsJson String  // JSON array
  materialsJson        String  // JSON array
  stepsJson            String  // JSON array of step objects
  targetMonthMin       Int?
  targetMonthMax       Int?
  goal                 String?
  durationMinutes      Int?
  frequency            String?
  difficulty           String?
  supervision          String?
  safetyJson           String  // JSON array
  stopConditionsJson   String  // JSON array
  evidenceType         String?
  medicalTreatment     Boolean @default(false)
  notes                String?
  sourceRefsJson       String  // JSON array
}

// ─── Family Food Plan ───────────────────────────────────────────────────────

model FoodPlan {
  id          String   @id @default(uuid())
  babyId      String
  baby        Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  date        String
  name        String
  tags        String   // JSON array
  nutrition   String
  ingredients String   // JSON array
  steps       String   // JSON array
  createdAt   DateTime @default(now())

  @@index([babyId, date])
}

// ─── Family Vaccine Record (actual completed/scheduled record for baby) ─────

model VaccineRecord {
  id            String   @id @default(uuid())
  babyId        String
  baby          Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  name          String
  dose          String
  scheduledDate String
  completedDate String?
  isCompleted   Boolean  @default(false)
  countdownDays Int?

  @@index([babyId, scheduledDate])
}

// ─── Family Vaccine Selection (which optional vaccines the family chooses) ──

model VaccineSelection {
  id         String   @id @default(uuid())
  babyId     String
  baby       Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  vaccineId  String
  doseNumber Int      @default(1)
  selected   Boolean  @default(true)
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([babyId, vaccineId, doseNumber])
}

// ─── Web Push Subscriptions ─────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keysJson  String
  createdAt DateTime @default(now())

  @@index([userId])
}


// ===== AI 异步任务与不可变审计存档 =====
model AiJob {
  id           String    @id @default(uuid())
  userId       String
  babyId       String?
  type         String    // medical_ocr | growth_ocr | ...
  status       String    @default("processing") // processing | done | failed
  inputArchiveId String?
  resultJson   String?
  imageUrl     String?
  errorMessage String?
  claimed      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([userId, createdAt])
  @@index([status, claimed])
}

model AiArchive {
  id          String   @id @default(uuid())
  kind        String   // input_image | input_audio | input_text | output_json | output_error
  filePath    String?
  content     String?
  contentHash String   // sha256，只读追溯防篡改
  byteSize    Int?
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
}

// ─── AI Chat Session & History Persistence ───────────────────────────────────

model AiChatSession {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyId      String?
  baby        Baby?           @relation(fields: [babyId], references: [id], onDelete: SetNull)
  title       String          @default("新对话")
  contextType String          @default("general")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  messages    AiChatMessage[]

  @@index([userId, updatedAt])
  @@index([babyId, updatedAt])
}

model AiChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String        // "user" | "assistant" | "system"
  content   String
  image     String?
  toolsJson String?       // JSON serialized tool traces / evidence citations
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
}

// ─── OAuth 2.1 & Dynamic Client Registration (RFC 7591 / RFC 9728) ────────────

model OAuthClient {
  id                      String                   @id @default(uuid())
  clientId                String                   @unique
  clientSecret            String?
  clientName              String?
  redirectUrisJson        String                   // JSON array of strings
  grantTypesJson          String                   @default("[\"authorization_code\",\"refresh_token\"]")
  responseTypesJson       String                   @default("[\"code\"]")
  scope                   String?                  @default("baby:read baby:write")
  tokenEndpointAuthMethod String                   @default("none") // "none" | "client_secret_post" | "client_secret_basic"
  isDynamic               Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  authorizationCodes      OAuthAuthorizationCode[]
  refreshTokens           OAuthRefreshToken[]
  consents                OAuthConsent[]
}

model OAuthAuthorizationCode {
  id                  String      @id @default(uuid())
  code                String      @unique
  clientId            String
  client              OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyId              String?
  baby                Baby?       @relation(fields: [babyId], references: [id], onDelete: SetNull)
  redirectUri         String
  scope               String
  resource            String?
  codeChallenge       String
  codeChallengeMethod String      @default("S256")
  expiresAt           DateTime
  used                Boolean     @default(false)
  createdAt           DateTime    @default(now())

  @@index([clientId])
  @@index([userId])
  @@index([code])
}

model OAuthRefreshToken {
  id        String      @id @default(uuid())
  tokenHash String      @unique
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyId    String?
  baby      Baby?       @relation(fields: [babyId], references: [id], onDelete: SetNull)
  scope     String
  resource  String?
  expiresAt DateTime
  revoked   Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([clientId])
  @@index([userId])
  @@index([tokenHash])
}

model OAuthConsent {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  babyId    String?
  baby      Baby?       @relation(fields: [babyId], references: [id], onDelete: SetNull)
  scope     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, clientId, babyId])
  @@index([userId])
  @@index([clientId])
}

model OAuthAuditLog {
  id           String   @id @default(uuid())
  requestId    String?
  clientId     String?
  userId       String?
  babyId       String?
  action       String   // e.g. "token_issue", "token_refresh", "token_revoke", "client_register", "mcp_tool_call"
  toolName     String?
  authResult   String   // "success" | "denied" | "error"
  durationMs   Int?
  statusCode   Int?
  ip           String?
  userAgent    String?
  metadataJson String?  // Non-sensitive metadata only (NO tokens or secrets)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([clientId, createdAt])
  @@index([action, createdAt])
}

model RecordSnapshot {
  id          String    @id @default(uuid())
  babyId      String
  baby        Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  userId      String?
  source      String    @default("mcp") // "mcp" | "web_chat" | "ui_manual"
  action      String    @default("delete") // "delete" | "update" | "batch_overwrite"
  entityType  String    // "feeding" | "sleep" | "diaper" | "food" | "growth" | "medical_report" | "vaccine" | "food_plan"
  entityId    String
  payloadJson String    // Full serialized JSON state before deletion/update
  restored    Boolean   @default(false)
  restoredAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([babyId, createdAt])
  @@index([entityType, entityId])
}

