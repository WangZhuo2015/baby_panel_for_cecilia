generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── User & Family Models (Multi-parent Sharing) ────────────────────────────

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  passwordHash      String
  displayName       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       FamilyMember[]
  pushSubscriptions PushSubscription[]
}

model Family {
  id           String             @id @default(uuid())
  name         String
  inviteCode   String             @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  members      FamilyMember[]
  babies       Baby[]
  foodStatuses FamilyFoodStatus[]
  bookStatuses FamilyBookStatus[]
}

model FamilyMember {
  id        String   @id @default(uuid())
  familyId  String
  userId    String
  role      String   @default("member") // "admin" | "member"
  relation  String   @default("parent") // "mother" | "father" | "grandparent" | "caregiver" | "other"
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

// ─── Core Baby Tracking Models ──────────────────────────────────────────────

model Baby {
  id                 String              @id @default(uuid())
  familyId           String
  family             Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  nickname           String
  gender             String              @default("female")
  birthDate          String
  gestationalAge     Int?
  avatarUrl          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  feedingRecords     FeedingRecord[]
  sleepRecords       SleepRecord[]
  diaperRecords      DiaperRecord[]
  growthMeasurements GrowthMeasurement[]
  foodLogRecords     FoodLogRecord[]
  foodPlans          FoodPlan[]
  vaccineRecords     VaccineRecord[]
  vaccineSelections  VaccineSelection[]
  medicalReports     MedicalReport[]
}

model FeedingRecord {
  id           String   @id @default(uuid())
  babyId       String
  baby         Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  recordedById String?
  timestamp    String
  type         String   // breast, formula, mixed
  amountMl     Int?
  leftMinutes  Int?
  rightMinutes Int?
  spitUp       Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
}

model SleepRecord {
  id               String   @id @default(uuid())
  babyId           String
  baby             Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  recordedById     String?
  startTime        String
  endTime          String
  type             String   // night, day
  nightWakingCount Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())
}

model DiaperRecord {
  id              String   @id @default(uuid())
  babyId          String
  baby            Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  recordedById    String?
  timestamp       String
  type            String   // pee, poop, both
  poopColor       String?  // yellow, green, brown, other
  poopConsistency String?  // loose, paste, formed
  notes           String?
  createdAt       DateTime @default(now())
}

model GrowthMeasurement {
  id                  String   @id @default(uuid())
  babyId              String
  baby                Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  recordedById        String?
  date                String
  ageInMonths         Int?
  ageLabel            String
  weightKg            Float?
  heightCm            Float?
  headCircumferenceCm Float?
  percentile          Int?
  imageUrl            String?
  createdAt           DateTime @default(now())
}

model MedicalReport {
  id           String   @id @default(uuid())
  babyId       String
  baby         Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  recordedById String?
  title        String
  category     String   // "blood" | "growth" | "trace_element" | "allergy" | "general"
  date         String   // YYYY-MM-DD
  hospital     String?
  doctorNotes  String?
  aiSummary    String?
  itemsJson    String   // JSON string of MedicalReportItem[]
  imageUrl     String?  // Archived photo
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([babyId, date])
}

model FoodLogRecord {
  id            String   @id @default(uuid())
  babyId        String
  baby          Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  recordedById  String?
  date          String
  time          String
  foods         String   // JSON array
  portion       String   // little, half, most, all
  acceptance    Int
  babyState     String   // happy, neutral, rejected
  hasAbnormal   Boolean  @default(false)
  abnormalNotes String?
  createdAt     DateTime @default(now())
}

// ─── Family Status for Shared Knowledge (Foods & Books) ─────────────────────

model FamilyFoodStatus {
  id             String   @id @default(uuid())
  familyId       String
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  foodId         String
  status         String   @default("to_try") // "tried" | "to_try"
  firstAddedDate String?
  acceptance     Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([familyId, foodId])
}

model FamilyBookStatus {
  id         String   @id @default(uuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  bookId     String
  readCount  Int      @default(0)
  isFavorite Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([familyId, bookId])
}

// ─── Data Version / Source Reference ─────────────────────────────────────────

model DataRelease {
  id        String      @id @default(uuid())
  title     String
  asOf      String      // e.g. "2026-08-03"
  createdAt DateTime    @default(now())
  sources   SourceRef[]
}

model SourceRef {
  id                  String               @id @default(uuid())
  sourceId            String               // e.g. "src_nip_2026"
  title               String
  organization        String
  year                Int?
  publicationDate     String?
  url                 String?
  sourceLevel         String?              // A, B, C, D
  sourceType          String?
  accessedDate        String?
  notes               String?
  dataReleaseId       String?
  dataRelease         DataRelease?         @relation(fields: [dataReleaseId], references: [id])
  vaccineSourceRefs   VaccineSourceRef[]   @relation("vaccineSourceRefs")
  milestoneSourceRefs MilestoneSourceRef[] @relation("milestoneSourceRefs")
}

// ─── Vaccine Models (Shared Static Reference) ───────────────────────────────

model Vaccine {
  id                        String              @id @default(uuid())
  vaccineId                 String              @unique // e.g. "vac_hepb"
  name                      String
  shortName                 String
  englishName               String?
  programType               String              // national_immunization_program, non_program, provincial_immunization_program
  legacyLabel               String?             // "一类（旧称）" etc.
  sexRestriction            String              @default("all")
  chinaNational             Boolean             @default(false)
  diseases                  String              // JSON array
  targetPopulation          String?
  policyEffectiveDate       String?
  policyVersion             String?
  routineHealthyChildOption Boolean             @default(true)
  manualReviewRequired      Boolean             @default(false)
  marketStatus              String?             // marketed, etc.
  productBrandName          String?
  productManufacturer       String?
  productApprovalNumber     String?
  jiangsuNotes              String?
  suzhouNotes               String?
  catchUpSupported          Boolean             @default(false)
  catchUpRules              String              // JSON array of strings
  simultaneousVaccination   String?
  substitutionRules         String              // JSON array of strings
  contraindications         String              // JSON array of strings
  precautions               String              // JSON array of strings
  specialPopulations        String              // JSON array of strings
  regionalOverrides         String              // JSON array of regional override objects
  regimenOptions            String              // JSON array
  sourceRefsJson            String              // JSON array of source IDs
  createdAt                 DateTime            @default(now())
  doses                     VaccineDose[]
  sourceRefs                VaccineSourceRef[]
}

model VaccineDose {
  id                              String   @id @default(uuid())
  vaccineId                       String
  vaccine                         Vaccine  @relation(fields: [vaccineId], references: [id])
  doseNumber                      Int
  doseLabel                       String
  recommendedAgeMonths            Int?
  minimumAgeDays                  Int?
  maximumAgeDays                  Int?
  recommendedAgeMaxMonths         Int?
  minimumIntervalDaysFromPrevious Int?
  maximumIntervalDaysFromPrevious Int?
  route                           String?
  site                            String?
  doseVolumeMl                    Float?
  notes                           String?
  sourceRefsJson                  String   // JSON array
}

model VaccineSourceRef {
  id          String    @id @default(uuid())
  vaccineId   String
  vaccine     Vaccine   @relation(fields: [vaccineId], references: [id])
  sourceRefId String
  sourceRef   SourceRef @relation("vaccineSourceRefs", fields: [sourceRefId], references: [id])
}

model VaccineStrategyGroup {
  id             String  @id @default(uuid())
  strategyId     String  @unique
  name           String
  scope          String?
  baseProgram    String?
  optionsJson    String  // JSON array of option objects
  sourceRefsJson String  // JSON array
}

model VaccineScheduleEntry {
  id             String  @id @default(uuid())
  ageMonths      Int?
  ageDays        Int?
  ageLabel       String?
  vaccineId      String
  doseNumber     Int
  priority       String  // routine, optional
  isOptional     Boolean @default(false)
  action         String?
  selectionGroup String?
  notes          String?
  sourceRefsJson String  // JSON array
}

model ScheduleEngineRule {
  id             String @id @default(uuid())
  ruleId         String @unique
  type           String
  vaccineIdsJson String // JSON array
  description    String
  sourceRefsJson String // JSON array
}

// ─── Development Milestone Models (Shared Static Reference) ─────────────────

model DevelopmentMilestone {
  id                             String               @id @default(uuid())
  milestoneId                    String               @unique // e.g. "mil_so_2m_looks_face"
  category                       String               // social_emotional, language, cognitive, gross_motor, fine_motor
  originalDomain                 String?              // 社交/情绪, 语言/沟通, etc.
  title                          String
  description                    String
  assessmentAgeMonths            Int
  ageRangeEarliestMonth          Int?
  ageRangeMedianMonth            Int?
  ageRangeLatestMonth            Int?
  criterionType                  String?              // by_age
  criterionThreshold             String?
  criterionDescription           String?
  observationMethod              String?
  requiresProfessionalAssessment Boolean              @default(false)
  sourceSystem                   String?
  sourceRefsJson                 String               // JSON array
  sourceRefs                     MilestoneSourceRef[]
}

model MilestoneSourceRef {
  id          String               @id @default(uuid())
  milestoneId String
  milestone   DevelopmentMilestone @relation(fields: [milestoneId], references: [id])
  sourceRefId String
  sourceRef   SourceRef            @relation("milestoneSourceRefs", fields: [sourceRefId], references: [id])
}

model DevelopmentWarningSign {
  id                String @id @default(uuid())
  warningSignId     String @unique // e.g. "rf_3m_01"
  ageMonths         Int
  category          String // language, social_emotional, cognitive, gross_motor, fine_motor
  description       String
  recommendedAction String
  urgency           String // routine_evaluation, etc.
  sourceRefsJson    String // JSON array
}

// ─── Feeding Guideline Models (Shared Static Reference) ─────────────────────

model FeedingGuideline {
  id                    String   @id @default(uuid())
  ageMinMonths          Int
  ageMaxMonths          Int
  mealFrequency         String?
  milkGuidance          String?
  textureJson           String   // JSON array of strings
  foodDiversityJson     String   // JSON array of strings
  responsiveFeedingJson String   // JSON array of strings
  safetyJson            String   // JSON array of strings
  sourceRefsJson        String   // JSON array
}

// ─── Food Item Model (Shared Static Reference) ──────────────────────────────

model FoodItem {
  id                               String   @id @default(uuid())
  foodId                           String   @unique // e.g. "food_iron_cereal"
  name                             String
  icon                             String
  category                         String   // grain, protein, vegetable, fruit, dairy, other
  foodGroup                        String?  // grain, meat, egg, fish, etc.
  // Introduction data
  recommendedFromMonth             Int?
  recommendedToMonth               Int?
  exactMonthEvidence               Boolean  @default(false)
  guidance                         String?  // main display text
  // Allergen data
  isCommonAllergen                 Boolean? // null = unconfirmed
  allergenIntroductionGuidance     String?
  highRiskInfantNeedsMedicalAdvice Boolean?
  // Choking
  chokingRisk                      Boolean  @default(false)
  chokingNotes                     String?
  // Preparation
  preparationJson                  String   // JSON array of strings
  // Avoid before
  avoidBeforeMonths                Int?
  // Nutrition
  nutritionJson                    String   // JSON array of strings
  // Texture by age
  textureByAgeJson                 String   // JSON array
  // Notes
  notes                            String?
  sourceRefsJson                   String   // JSON array
}

// ─── Book Model (Shared Static Reference) ───────────────────────────────────

model Book {
  id                         String   @id @default(uuid())
  bookId                     String   @unique // e.g. "book_beng"
  title                      String
  originalTitle              String?
  authorJson                 String   // JSON array
  illustratorJson            String?  // JSON array
  translatorJson             String?  // JSON array
  publisher                  String?
  isbn                       String?
  editionYear                Int?
  language                   String?
  origin                     String?  // translated, domestic
  ageMinMonths               Int?
  ageMaxMonths               Int?
  categoriesJson             String   // JSON array
  bookFormat                 String?  // picture_book, board_book, etc.
  description                String?
  interactionSuggestionsJson String?  // JSON array
  whyAgeAppropriate          String?
  ratingScore                Float?   // null means no data
  ratingCount                Int?
  ratingSource               String?
  ratingRetrievedDate        String?
  coverColor                 String?  // null means use default
  sourceRefsJson             String   // JSON array
}

// ─── Activity Model (Shared Static Reference) ───────────────────────────────

model ActivityRecommendation {
  id                   String  @id @default(uuid())
  activityId           String  @unique // e.g. "act_face_talk"
  title                String
  categoriesJson       String  // JSON array
  ageMinMonths         Int?
  ageMaxMonths         Int?
  developmentGoalsJson String  // JSON array
  materialsJson        String  // JSON array
  stepsJson            String  // JSON array of step objects
  targetMonthMin       Int?
  targetMonthMax       Int?
  goal                 String?
  durationMinutes      Int?
  frequency            String?
  difficulty           String?
  supervision          String?
  safetyJson           String  // JSON array
  stopConditionsJson   String  // JSON array
  evidenceType         String?
  medicalTreatment     Boolean @default(false)
  notes                String?
  sourceRefsJson       String  // JSON array
}

// ─── Family Food Plan ───────────────────────────────────────────────────────

model FoodPlan {
  id          String   @id @default(uuid())
  babyId      String
  baby        Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  date        String
  name        String
  tags        String   // JSON array
  nutrition   String
  ingredients String   // JSON array
  steps       String   // JSON array
  createdAt   DateTime @default(now())
}

// ─── Family Vaccine Record (actual completed/scheduled record for baby) ─────

model VaccineRecord {
  id            String   @id @default(uuid())
  babyId        String
  baby          Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  name          String
  dose          String
  scheduledDate String
  completedDate String?
  isCompleted   Boolean  @default(false)
  countdownDays Int?
}

// ─── Family Vaccine Selection (which optional vaccines the family chooses) ──

model VaccineSelection {
  id         String   @id @default(uuid())
  babyId     String
  baby       Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)
  vaccineId  String
  doseNumber Int      @default(1)
  selected   Boolean  @default(true)
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([babyId, vaccineId, doseNumber])
}

// ─── Web Push Subscriptions ─────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keysJson  String
  createdAt DateTime @default(now())
}
