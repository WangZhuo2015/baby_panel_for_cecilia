  "activities": [
    {
      "id": "act_face_talk",
      "title": "面对面说话与回应",
      "categories": [
        "language",
        "social_emotional"
      ],
      "ageMinMonths": 0,
      "ageMaxMonths": 3,
      "developmentGoals": [
        "建立轮流互动",
        "促进对人脸和声音的关注"
      ],
      "materials": [],
      "steps": [
        {
          "order": 1,
          "instruction": "在孩子清醒、舒适时把脸保持在其容易看到的位置。"
        },
        {
          "order": 2,
          "instruction": "用轻柔声音说短句，停顿等待孩子用注视、表情或声音回应。"
        },
        {
          "order": 3,
          "instruction": "对孩子的声音或表情及时回应。"
        }
      ],
      "durationMinutes": null,
      "frequency": null,
      "difficulty": "easy",
      "supervision": "continuous",
      "safety": [
        "不在孩子困倦需要睡眠时持续刺激。"
      ],
      "stopConditions": [
        "孩子明显疲倦、持续哭闹或主动回避时停止。",
        "出现呼吸困难、发绀、受伤或其他急性不适时立即停止并按需要就医。"
      ],
      "evidenceType": "developmentally_appropriate_play",
      "medicalTreatment": false,
      "notes": null,
      "sourceRefs": [
        "src_nhc_care_2022"
      ]
    },
    {
