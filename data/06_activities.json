    {
      "id": "act_tummy_time",
      "title": "清醒俯卧抬头游戏",
      "categories": [
        "gross_motor"
      ],
      "ageMinMonths": 1,
      "ageMaxMonths": 6,
      "developmentGoals": [
        "练习俯卧抬头和上肢支撑"
      ],
      "materials": [
        "平整、牢固的地面垫"
      ],
      "steps": [
        {
          "order": 1,
          "instruction": "仅在孩子清醒且成人全程看护时，将孩子置于平整牢固的垫面俯卧。"
        },
        {
          "order": 2,
          "instruction": "成人在前方用脸或声音吸引其短暂抬头。"
        },
        {
          "order": 3,
          "instruction": "孩子累了就改回舒适体位。"
        }
      ],
      "durationMinutes": null,
      "frequency": null,
      "difficulty": "easy",
      "supervision": "continuous",
      "safety": [
        "只用于清醒活动，不作为睡眠姿势。",
        "避免沙发、床等高处或柔软表面。"
      ],
      "stopConditions": [
        "孩子明显疲倦、持续哭闹或主动回避时停止。",
        "出现呼吸困难、发绀、受伤或其他急性不适时立即停止并按需要就医。"
